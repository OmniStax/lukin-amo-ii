{"types": [], "symbols": [{"sym": "a_0", "latex": "a_0", "macro": "\\kazero"}, {"sym": "H_motion", "latex": "\\hat{H}_\\mathrm{motion}", "macro": "\\kHmotion"}, {"sym": "H_electronic", "latex": "\\hat{H}_\\mathrm{electronic}", "macro": "\\kHelectronic"}, {"sym": "omega_eg", "latex": "\\omega_{eg}", "macro": "\\komegaeg"}, {"sym": "eta_LD", "latex": "\\eta", "macro": "\\ketaLD"}, {"sym": "H_r", "latex": "\\hat{H}_r", "macro": "\\kHr"}, {"sym": "H_s", "latex": "\\hat{H}_s", "macro": "\\kHs"}, {"sym": "H_0", "latex": "\\hat{H}_0", "macro": "\\kHzero"}, {"sym": "nu_s", "latex": "\\sqrt{3}\\nu", "macro": "\\knus"}, {"sym": "omega_c", "latex": "\\omega_c", "macro": "\\komegac"}, {"sym": "omega_plus", "latex": "\\omega_+", "macro": "\\komegaplus"}, {"sym": "omega_minus", "latex": "\\omega_-", "macro": "\\komegaminus"}, {"sym": "omega_z", "latex": "\\omega_z", "macro": "\\komegaz"}, {"sym": "Omega_RF", "latex": "\\Omega_\\mathrm{RF}", "macro": "\\kOmegaRF"}, {"sym": "x_ion", "latex": "\\hat{x}", "macro": "\\kxion"}, {"sym": "x_disp", "latex": "x", "macro": "\\kxdisp"}, {"sym": "X_cm", "latex": "X", "macro": "\\kXcm"}, {"sym": "P_cm", "latex": "P", "macro": "\\kPcm"}, {"sym": "a_sep", "latex": "a", "macro": "\\kasep"}], "concepts": [{"id": "ion-trap-principle", "kind": "result", "section": "10.1", "name": "约束离子", "statement": "离子通过库仑力强烈响应外加电场，这使得极紧的阱成为可能，但无法产生静电场的极小值，因此离子不能仅靠静电场来约束；磁场或射频电场提供三维约束。"}, {"id": "penning-trap", "kind": "definition", "section": "10.1", "name": "彭宁阱", "terms": ["彭宁阱", "回旋运动", "磁控运动"], "statement": "彭宁阱通过离子在磁场中的回旋运动在两个维度上约束离子，在第三个维度上由带电端盖约束；正交的电场与磁场附加了尺度更大的磁控运动。"}, {"id": "quadrupole-potential", "kind": "definition", "section": "10.1", "name": "四极势", "statement": "一种四极电势，其系数之和按拉普拉斯方程为零，因此当 α = −β, γ = 0 时，它在一个方向上约束，在另一个方向上排斥。", "forms": [{"id": "eq-10-1", "latex": "\\Phi = \\phi_0\\left(\\alpha x^2 + \\beta y^2 + \\gamma z^2\\right)", "anchor": "10.1-eq-10-1"}, {"id": "eq-10-laplace", "latex": "\\alpha + \\beta + \\gamma = 0", "anchor": "10.1-laplace"}]}, {"id": "paul-trap", "kind": "definition", "section": "10.1", "name": "保罗阱", "terms": ["保罗阱"], "statement": "保罗阱用高频四极势模拟出电场极小值：对振荡鞍面的许多个周期取平均，净效应是约束离子，加上带电端盖后在三维上约束。"}, {"id": "micromotion", "kind": "definition", "section": "10.1", "name": "微运动", "terms": ["微运动"], "statement": "离子跟随振荡的阱的运动，与之异相 180 度，因此它在靠近中心处遇到排斥势，在远离中心处遇到约束势。"}, {"id": "trapped-ion-model", "kind": "idea", "section": "10.2", "name": "陷俘离子模型", "statement": "就我们的目的而言，离子阱可以近似为谐振子势，离子受到激光激发和自发发射。"}, {"id": "ion-qubit-levels", "kind": "idea", "section": "10.2", "name": "冷却与量子比特跃迁", "terms": ["亚稳态", "四极跃迁"], "statement": "偶极容许跃迁弛豫很快，用于激光冷却和荧光读出；经四极跃迁驱动的长寿命亚稳态，寿命约一秒，用于编码信息。"}, {"id": "ion-hilbert-space", "kind": "definition", "section": "10.2", "name": "内态与运动态", "type": "state", "statement": "陷俘离子的希尔伯特空间是一个二能级系统连同一个由福克态构成的谐振子阶梯，后者描述其量子化的运动。"}, {"id": "ion-position-momentum", "kind": "definition", "section": "10.2", "name": "离子位置与动量算符", "statement": "离子的位置和动量用频率为 ν 的阱中一个振动能量子的产生算符和湮没算符来表示。", "forms": [{"id": "eq-10-2", "latex": "\\hat{x} = \\sqrt{\\frac{\\hbar}{2m\\nu}}\\left(\\hat{a} + \\hat{a}^\\dagger\\right)", "anchor": "10.2-eq-10-2"}, {"id": "eq-10-3", "latex": "\\hat{p} = i\\sqrt{\\frac{\\hbar m\\nu}{2}}\\left(\\hat{a}^\\dagger - \\hat{a}\\right)", "anchor": "10.2-eq-10-3"}]}, {"id": "trap-frequency", "kind": "definition", "section": "10.2", "name": "阱频率", "type": "frequency", "statement": "阱的谐振子频率 ν，得益于很强的库仑相互作用，对离子而言约为 10 MHz。"}, {"id": "motional-hamiltonian", "kind": "definition", "section": "10.2", "name": "运动哈密顿量", "symbol": "H_motion", "type": "energy", "statement": "离子运动的哈密顿量对其振动量子计数，每个量子的能量为 ℏν。", "forms": [{"id": "eq-10-4", "latex": "\\hat{H}_\\mathrm{motion} = \\hbar\\nu\\hat{a}^\\dagger\\hat{a}", "anchor": "10.2-eq-10-4"}]}, {"id": "harmonic-oscillator-length", "kind": "definition", "section": "10.2", "name": "谐振子长度", "symbol": "a_0", "type": "length", "statement": "离子运动基态波函数的特征尺寸，对被紧密陷俘的离子而言显著小于光波长。", "forms": [{"id": "eq-10-5", "latex": "a_0 = \\sqrt{\\frac{\\hbar}{2m\\nu}}", "anchor": "10.2-eq-10-5"}]}, {"id": "ion-electronic-hamiltonian", "kind": "definition", "section": "10.2", "name": "电子哈密顿量", "symbol": "H_electronic", "type": "energy", "statement": "忽略自发发射时，离子的内部能级是一个二能级系统，基态为 |g⟩，激发态 |e⟩ 位于 ℏω_eg 处。", "forms": [{"id": "eq-10-6", "latex": "\\hat{H}_\\mathrm{electronic} = \\hbar\\omega_{eg}|e\\rangle\\langle e|", "anchor": "10.2-eq-10-6"}]}, {"id": "negligible-decay-condition", "kind": "result", "section": "10.2", "name": "可忽略的衰变", "statement": "要忽略衰变，速率 γ 必须比操控时间 τ 的倒数小；这可通过经四极跃迁驱动的亚稳态，或通过远失谐拉曼跃迁来达到，后者使有效谱线宽度减小 (Ω/∆)²。", "forms": [{"id": "eq-10-gamma-tau", "latex": "\\gamma\\tau \\ll 1", "anchor": "10.2-gamma-tau"}]}, {"id": "ion-laser-hamiltonian", "kind": "definition", "section": "10.2", "name": "离子-激光相互作用", "type": "energy", "statement": "激光场作用于离子所在的位置，因此在行波或驻波的相互作用哈密顿量中，x 变为算符 x̂。", "forms": [{"id": "eq-10-9", "latex": "\\hat{H}_\\mathrm{running} = -\\hbar\\left(\\Omega|e\\rangle\\langle g|e^{i(k\\hat{x}-\\omega t)} + h.c.\\right)", "anchor": "10.2-eq-10-9"}, {"id": "eq-10-10", "latex": "\\hat{H}_\\mathrm{standing} = -\\hbar\\left(\\Omega|e\\rangle\\langle g|\\sin{(k\\hat{x} + \\phi)}e^{-i\\omega t} + h.c.\\right)", "anchor": "10.2-eq-10-10"}, {"id": "eq-10-7", "latex": "E_\\mathrm{running} = \\mathcal{E}e^{i(kx-\\omega t)} + c.c.", "anchor": "10.2-eq-10-7"}, {"id": "eq-10-8", "latex": "E_\\mathrm{standing} = \\mathcal{E}\\sin{(kx + \\phi)}e^{-i\\omega t} + c.c.", "anchor": "10.2-eq-10-8"}]}, {"id": "ion-momentum-kick", "kind": "result", "section": "10.2", "name": "动量冲击", "statement": "吸收一个光子给离子一个动量冲击 ℏk，这可以激发更高的振动态，因此激光激发操控质心运动。", "forms": [{"id": "eq-10-11", "latex": "|g\\rangle|p\\rangle \\rightarrow |e\\rangle e^{ik\\hat{x}}|p\\rangle = |e\\rangle|p + \\hbar k\\rangle", "anchor": "10.2-eq-10-11"}]}, {"id": "lamb-dicke-parameter", "kind": "definition", "section": "10.2", "name": "兰姆-迪克参数", "terms": ["兰姆-迪克参数"], "symbol": "eta_LD", "statement": "离子的空间范围与激光波长之比，对紧阱而言是小参数；它也是反冲频率除以阱频率的平方根。", "forms": [{"id": "eq-10-12", "latex": "\\eta = \\frac{2\\pi a_0}{\\lambda}", "anchor": "10.2-eq-10-12"}, {"id": "eq-10-13", "latex": "\\eta = \\sqrt{\\frac{\\omega_R}{\\nu}}", "anchor": "10.2-eq-10-13"}]}, {"id": "lamb-dicke-regime", "kind": "definition", "section": "10.2", "name": "兰姆-迪克情形", "terms": ["兰姆-迪克情形"], "statement": "离子束缚得如此之紧，以致光子的反冲能无法激发更高的振动态的极限，于是光子动量由阱而不是离子吸收；真正的展开参数是 η√n。"}, {"id": "lamb-dicke-hamiltonian", "kind": "definition", "section": "10.2", "name": "陷俘离子哈密顿量", "symbol": "H_r", "type": "energy", "statement": "在转动参考系中，陷俘离子的总哈密顿量由运动、失谐的内部能级和激光耦合组成，行波时 η 在指数中，驻波时 η 在正弦中。", "forms": [{"id": "eq-10-14", "latex": "\\hat{H}_r = \\hbar\\nu\\hat{a}^\\dagger\\hat{a} - \\hbar\\Delta|e\\rangle\\langle e| - \\hbar\\left(\\Omega|e\\rangle\\langle g|e^{i\\eta(\\hat{a}+\\hat{a}^\\dagger)} + h.c.\\right)", "anchor": "10.2-eq-10-14"}, {"id": "eq-10-15", "latex": "\\hat{H}_s = \\hbar\\nu\\hat{a}^\\dagger\\hat{a} - \\hbar\\Delta|e\\rangle\\langle e| - \\hbar\\left(\\Omega|e\\rangle\\langle g|\\sin\\left(\\eta(\\hat{a} + \\hat{a}^\\dagger) + \\phi\\right) + h.c.\\right)", "anchor": "10.2-eq-10-15"}]}, {"id": "ion-bare-spectrum", "kind": "result", "section": "10.2", "name": "裸离子谱", "symbol": "H_0", "type": "energy", "statement": "裸态 |g⟩|n⟩ 和 |e⟩|n⟩ 是基态和激发态电子能级，由于 ω_eg ≫ ν 而分得很开，每个又细分为间隔为 ν 的运动态。", "forms": [{"id": "eq-10-16", "latex": "\\hat{H}_0 = \\hbar\\nu\\hat{a}^\\dagger\\hat{a} + \\hbar\\omega_{eg}|e\\rangle\\langle e|", "anchor": "10.2-eq-10-16"}, {"id": "eq-10-17", "latex": "\\hat{H}_0|g\\rangle|n\\rangle = \\hbar n\\nu|g\\rangle|n\\rangle", "anchor": "10.2-eq-10-17"}, {"id": "eq-10-18", "latex": "\\hat{H}_0|e\\rangle|n\\rangle = \\hbar(n\\nu + \\omega_{eg})|e\\rangle|n\\rangle", "anchor": "10.2-eq-10-18"}]}, {"id": "sideband-couplings", "kind": "result", "section": "10.2", "name": "载波与边带耦合", "terms": ["红边带", "蓝边带"], "type": "coupling", "statement": "在 η 的最低阶，行波只把 |g⟩|n⟩ 耦合到强度为 Ω 的 |e⟩|n⟩，以及强度为 ηΩ√(n+1) 和 ηΩ√n 的 |e⟩|n±1⟩；通过调谐激光可以逐一对这三个跃迁寻址，边带拉比频率随声子数增大。", "forms": [{"id": "eq-10-19", "latex": "\\langle g|\\langle n|\\hat{H}|e\\rangle|m\\rangle = -\\hbar\\Omega^*\\langle n|e^{-i\\eta(\\hat{a}+\\hat{a}^\\dagger)}|m\\rangle", "anchor": "10.2-drv-sideband-couplings"}, {"id": "eq-10-20", "latex": "\\langle g|\\langle n|\\hat{H}|e\\rangle|n\\rangle = -\\hbar\\Omega^*\\left(1 + \\mathcal{O}(\\eta^2)\\right)", "anchor": "10.2-drv-sideband-couplings"}, {"id": "eq-10-21", "latex": "\\langle g|\\langle n|\\hat{H}|e\\rangle|n+1\\rangle = -\\hbar\\Omega^*\\left(-i\\eta\\sqrt{n+1} + \\mathcal{O}(\\eta^3)\\right)", "anchor": "10.2-drv-sideband-couplings"}, {"id": "eq-10-22", "latex": "\\langle g|\\langle n|\\hat{H}|e\\rangle|n-1\\rangle = -\\hbar\\Omega^*\\left(-i\\eta\\sqrt{n} + \\mathcal{O}(\\eta^3)\\right)", "anchor": "10.2-drv-sideband-couplings"}]}, {"id": "carrier-transition", "kind": "result", "section": "10.2", "name": "裸共振跃迁", "type": "energy", "statement": "激光处在裸原子共振上且足够弱，Ω ≪ ν/η，则边带被抑制，内部与运动自由度解耦：离子在内态之间循环而不改变其运动态。", "forms": [{"id": "eq-10-23", "latex": "\\hat{H} = \\hbar\\nu\\hat{a}^\\dagger\\hat{a} - \\hbar\\Delta|e\\rangle\\langle e| - \\hbar\\Omega\\left(|e\\rangle\\langle g| + |g\\rangle\\langle e|\\right)", "anchor": "10.2-eq-10-23"}, {"id": "eq-10-carrier-condition", "latex": "\\Omega \\ll \\nu/\\eta", "anchor": "10.2-carrier-condition"}]}, {"id": "red-sideband-jaynes-cummings", "kind": "result", "section": "10.2", "name": "作为 J-C 模型的红边带", "type": "energy", "statement": "在红边带上，离子遵从 J-C 模型，内部跃迁伴随着声子的产生或湮没，真空拉比耦合取代 g → ηΩ。", "forms": [{"id": "eq-10-24", "latex": "\\hat{H} = \\hbar\\nu\\hat{a}^\\dagger\\hat{a} - \\hbar\\Delta|e\\rangle\\langle e| - i\\hbar\\eta\\Omega\\left(|e\\rangle\\langle g|\\hat{a} + |g\\rangle\\langle e|\\hat{a}^\\dagger\\right)", "anchor": "10.2-eq-10-24"}]}, {"id": "trapped-ion-strong-coupling", "kind": "idea", "section": "10.2", "name": "离子的强耦合", "statement": "由于耦合 ηΩ 随激光功率增大，用离子阱比在腔量子电动力学中显著更容易达到强耦合情形，且耦合可用激光开启和关闭。"}, {"id": "anti-jaynes-cummings", "kind": "result", "section": "10.2", "name": "反 J-C 模型", "terms": ["反 J-C"], "type": "energy", "statement": "在蓝边带上，离子遵从反 J-C 哈密顿量，内部激发伴随着声子的发射，反之亦然。", "forms": [{"id": "eq-10-25", "latex": "\\hat{H} = \\hbar\\nu\\hat{a}^\\dagger\\hat{a} - \\hbar\\Delta|e\\rangle\\langle e| - i\\hbar\\eta\\Omega\\left(|e\\rangle\\langle g|\\hat{a}^\\dagger + |g\\rangle\\langle e|\\hat{a}\\right)", "anchor": "10.2-eq-10-25"}]}, {"id": "standing-wave-couplings", "kind": "result", "section": "10.2", "name": "驻波耦合", "symbol": "H_s", "type": "energy", "statement": "在驻波中，波相对于阱极小值的相位 φ 是又一个控制量：φ = 0 时垂直跃迁被消除，只剩下边带。", "forms": [{"id": "eq-10-26", "latex": "\\hat{H}_s = \\hbar\\nu\\hat{a}^\\dagger\\hat{a} - \\hbar\\Delta|e\\rangle\\langle e| - \\hbar\\left(\\Omega|e\\rangle\\langle g|\\left(\\sin\\phi + \\eta(\\hat{a} + \\hat{a}^\\dagger)\\cos\\phi + \\mathcal{O}(\\eta^2)\\right) + h.c.\\right)", "anchor": "10.2-eq-10-26"}]}, {"id": "sideband-cooling", "kind": "definition", "section": "10.2", "name": "边带冷却", "terms": ["边带冷却"], "statement": "容许跃迁红边带上的激光在每个激发循环中降低运动能量，而发射进入全部三个跃迁，平均而言把离子抽运到阱的基态，该基态对激光是暗的。"}, {"id": "resolved-sideband-condition", "kind": "result", "section": "10.2", "name": "可分辨边带", "statement": "冷却速率由荧光率 γ 决定，但冷却到基态要求 γ ≪ ν，这样直接跃迁和蓝边带跃迁的非共振激发才可以忽略；用第二束激光把禁戒能级耦合到容许能级，可调节有效的自发发射率。", "forms": [{"id": "eq-10-resolved", "latex": "\\gamma \\ll \\nu", "anchor": "10.2-resolved"}]}, {"id": "motional-state-engineering", "kind": "definition", "section": "10.3", "name": "任意运动态", "type": "state", "statement": "离子的任意运动态，系数 c_n 可以是福克态、相干态、压缩态或薛定谔猫态；设计这类量子态对离子阱中的量子门至关重要。", "forms": [{"id": "eq-10-27", "latex": "|\\psi\\rangle = |g\\rangle \\otimes \\sum_{n=0}^{\\infty} c_n|n\\rangle", "anchor": "10.3-eq-10-27"}]}, {"id": "pulse-sequence-unitary", "kind": "idea", "section": "10.3", "name": "脉冲序列", "statement": "作用在裸跃迁和边带跃迁上的激光脉冲是一系列把初态联系到末态的幺正变换。", "forms": [{"id": "eq-10-28", "latex": "|f\\rangle = U_N U_{N-1}\\ldots U_2 U_1|i\\rangle", "anchor": "10.3-eq-10-28"}]}, {"id": "internal-motional-swap", "kind": "result", "section": "10.3", "name": "交换到运动上", "statement": "红边带上的 π 脉冲把信息从内态交换到运动态上。", "forms": [{"id": "eq-10-29", "latex": "|i\\rangle = (\\alpha|g\\rangle + \\beta|e\\rangle) \\otimes |0\\rangle", "anchor": "10.3-eq-10-29"}, {"id": "eq-10-30", "latex": "|f\\rangle = |g\\rangle \\otimes (\\alpha|0\\rangle + \\beta|1\\rangle)", "anchor": "10.3-eq-10-30"}]}, {"id": "motional-state-preparation", "kind": "skill", "section": "10.3", "name": "运动态的制备", "statement": "从目标态倒推，交替的红边带脉冲和裸共振脉冲把振子的最高梯级清空到下一个梯级，直到全部布居都在基态；逆序列制备该态。"}, {"id": "ion-string", "kind": "idea", "section": "10.4", "name": "离子串", "statement": "同一各向异性阱中的离子相互排斥成一串，间距为 5-10 μm，远到足以让聚焦的激光分辨每一个离子，同时库仑相互作用把它们的运动耦合成具有不同频率和空间形态的声子模式。"}, {"id": "two-ion-motion", "kind": "definition", "section": "10.4", "name": "阱中的两个离子", "type": "energy", "statement": "两个离子感受到谐振约束及它们的库仑斥力，后者在对偏离平衡位置的位移展开到最低阶时，在两者之间添加一根弹簧。", "forms": [{"id": "eq-10-31", "latex": "\\hat{H}_{motion} = \\sum_i\\left(\\frac{p_i^2}{2m} + \\frac{m}{2}\\nu^2 r_i^2\\right) + \\frac{e^2}{4\\pi\\epsilon_0|r_1 - r_2|}", "anchor": "10.4-eq-10-31"}, {"id": "eq-10-32", "latex": "\\hat{H}_{motion} = \\sum_i\\frac{p_i^2}{2m} + \\frac{m\\nu^2}{2}\\left(x_1^2 + x_2^2 + (x_2 - x_1)^2\\right)", "anchor": "10.4-drv-two-ion-expansion"}]}, {"id": "ion-normal-modes", "kind": "result", "section": "10.4", "name": "质心模式与伸缩模式", "symbol": "nu_s", "type": "frequency", "statement": "两个离子以频率 ν 的质心模式和 √3ν 的伸缩模式振动，它们是位移的对称组合与反对称组合。", "forms": [{"id": "eq-10-37", "latex": "\\hat{H}_{motion} = \\left(\\frac{P^2}{2m} + \\frac{m}{2}\\nu^2 X^2\\right) + \\left(\\frac{p^2}{2m} + \\frac{m}{2}3\\nu^2 x^2\\right)", "anchor": "10.4-drv-two-ion-normal-modes"}, {"id": "eq-10-33", "latex": "X = \\frac{1}{\\sqrt{2}}(x_1 + x_2)", "anchor": "10.4-eq-10-33"}, {"id": "eq-10-34", "latex": "x = \\frac{1}{\\sqrt{2}}(x_2 - x_1)", "anchor": "10.4-eq-10-34"}, {"id": "eq-10-35", "latex": "P = \\frac{1}{\\sqrt{2}}(p_1 + p_2)", "anchor": "10.4-eq-10-35"}, {"id": "eq-10-36", "latex": "p = \\frac{1}{\\sqrt{2}}(p_2 - p_1)", "anchor": "10.4-eq-10-36"}]}, {"id": "two-ion-laser-hamiltonian", "kind": "result", "section": "10.4", "name": "双离子哈密顿量", "type": "energy", "statement": "每个离子的激光把其内态耦合到两个声子模式，每个模式有其自己的兰姆-迪克参数，通过选择激光失谐可以分别寻址这两个模式。", "forms": [{"id": "eq-10-39", "latex": "\\begin{aligned} \\hat{H} = {} & \\hbar\\nu\\hat{a}_{cm}^\\dagger\\hat{a}_{cm} + \\hbar\\sqrt{3}\\nu\\hat{a}_s^\\dagger\\hat{a}_s - \\sum_i\\hbar\\Delta_i|e\\rangle_{ii}\\langle e| \\\\ & -\\hbar\\Omega_1\\left(|e\\rangle_{11}\\langle g|e^{i\\eta_{cm}(\\hat{a}_{cm}+\\hat{a}_{cm}^\\dagger)}e^{-i\\eta_s(\\hat{a}_s+\\hat{a}_s^\\dagger)} + h.c.\\right) \\\\ & -\\hbar\\Omega_2\\left(|e\\rangle_{22}\\langle g|e^{i\\eta_{cm}(\\hat{a}_{cm}+\\hat{a}_{cm}^\\dagger)}e^{i\\eta_s(\\hat{a}_s+\\hat{a}_s^\\dagger)} + h.c.\\right) \\end{aligned}", "anchor": "10.4-drv-two-ion-hamiltonian"}, {"id": "eq-10-38", "latex": "\\hat{H}_{int} = -\\sum_i\\left(\\hbar\\Delta_i|e\\rangle_{ii}\\langle e| + \\hbar\\Omega_i\\left(|e\\rangle_{ii}\\langle g|e^{ikx_i} + h.c.\\right)\\right)", "anchor": "10.4-eq-10-38"}]}, {"id": "qubit", "kind": "definition", "section": "10.4", "name": "量子比特", "terms": ["量子比特"], "type": "state", "statement": "存储信息的二能级量子系统，其内态读作比特值 |g⟩ = |0⟩ 和 |e⟩ = |1⟩，信息编码在态 α|0⟩ + β|1⟩ 中。"}, {"id": "universal-gate-set", "kind": "result", "section": "10.4", "name": "普适计算", "statement": "若每个量子比特都可以被寻址并任意旋转，普适计算只需要一个耦合任意双量子比特对的非平庸门。"}, {"id": "pi-phase-gate", "kind": "definition", "section": "10.4", "name": "π 相位门", "terms": ["相位门"], "statement": "仅当另一个量子比特也处于激发态时，才翻转一个量子比特的激发态的符号的双量子比特门。", "forms": [{"id": "eq-10-43", "latex": "|1\\rangle|1\\rangle \\rightarrow -|1\\rangle|1\\rangle", "anchor": "10.4-eq-10-43"}, {"id": "eq-10-40", "latex": "|0\\rangle|0\\rangle \\rightarrow |0\\rangle|0\\rangle", "anchor": "10.4-eq-10-40"}, {"id": "eq-10-41", "latex": "|0\\rangle|1\\rangle \\rightarrow |0\\rangle|1\\rangle", "anchor": "10.4-eq-10-41"}, {"id": "eq-10-42", "latex": "|1\\rangle|0\\rangle \\rightarrow |1\\rangle|0\\rangle", "anchor": "10.4-eq-10-42"}]}, {"id": "phase-gate-requirements", "kind": "idea", "section": "10.4", "name": "相位门的要求", "statement": "陷俘离子相位门需要冷却到基态的振动模式，以及一个与激发态简并、由正交的激光偏振耦合到基态的辅助能级。", "forms": [{"id": "eq-10-44", "latex": "|\\psi\\rangle = \\sum_x c_x|x_{N-1}\\ldots x_0\\rangle_\\mathrm{ion} \\otimes |0\\rangle_\\mathrm{phonon}", "anchor": "10.4-eq-10-44"}]}, {"id": "ion-trap-phase-gate", "kind": "result", "section": "10.4", "name": "离子阱相位门", "statement": "离子 m 与 n 之间的相位门用红边带 π 脉冲把量子比特 m 写到集体运动上，以运动为条件对离子 n 的辅助能级施加 2π 脉冲，并把运动写回量子比特 m，使态保持不变，除非两个量子比特都处于激发态，此时它变号。"}], "concept_prereqs": [{"concept": "penning-trap", "prereq": "ion-trap-principle"}, {"concept": "quadrupole-potential", "prereq": "ion-trap-principle"}, {"concept": "paul-trap", "prereq": "micromotion"}, {"concept": "micromotion", "prereq": "quadrupole-potential"}, {"concept": "trapped-ion-model", "prereq": "paul-trap"}, {"concept": "trapped-ion-model", "prereq": "two-level-atom"}, {"concept": "ion-qubit-levels", "prereq": "trapped-ion-model"}, {"concept": "ion-qubit-levels", "prereq": "spontaneous-emission-rate"}, {"concept": "ion-hilbert-space", "prereq": "trapped-ion-model"}, {"concept": "ion-hilbert-space", "prereq": "fock-states"}, {"concept": "ion-position-momentum", "prereq": "trap-frequency"}, {"concept": "ion-position-momentum", "prereq": "creation-annihilation-operators"}, {"concept": "trap-frequency", "prereq": "trapped-ion-model"}, {"concept": "motional-hamiltonian", "prereq": "ion-position-momentum"}, {"concept": "harmonic-oscillator-length", "prereq": "ion-position-momentum"}, {"concept": "ion-electronic-hamiltonian", "prereq": "ion-hilbert-space"}, {"concept": "ion-electronic-hamiltonian", "prereq": "atomic-transition-frequency"}, {"concept": "negligible-decay-condition", "prereq": "ion-qubit-levels"}, {"concept": "negligible-decay-condition", "prereq": "raman-transition"}, {"concept": "ion-laser-hamiltonian", "prereq": "ion-position-momentum"}, {"concept": "ion-laser-hamiltonian", "prereq": "rotating-wave-approximation"}, {"concept": "ion-momentum-kick", "prereq": "ion-laser-hamiltonian"}, {"concept": "ion-momentum-kick", "prereq": "atomic-recoil"}, {"concept": "lamb-dicke-parameter", "prereq": "harmonic-oscillator-length"}, {"concept": "lamb-dicke-parameter", "prereq": "recoil-frequency"}, {"concept": "lamb-dicke-regime", "prereq": "lamb-dicke-parameter"}, {"concept": "lamb-dicke-regime", "prereq": "ion-momentum-kick"}, {"concept": "lamb-dicke-hamiltonian", "prereq": "ion-laser-hamiltonian"}, {"concept": "lamb-dicke-hamiltonian", "prereq": "lamb-dicke-parameter"}, {"concept": "lamb-dicke-hamiltonian", "prereq": "motional-hamiltonian"}, {"concept": "lamb-dicke-hamiltonian", "prereq": "rotating-frame-hamiltonian"}, {"concept": "ion-bare-spectrum", "prereq": "motional-hamiltonian"}, {"concept": "ion-bare-spectrum", "prereq": "ion-electronic-hamiltonian"}, {"concept": "ion-bare-spectrum", "prereq": "bare-states"}, {"concept": "sideband-couplings", "prereq": "lamb-dicke-hamiltonian"}, {"concept": "sideband-couplings", "prereq": "ion-bare-spectrum"}, {"concept": "sideband-couplings", "prereq": "lamb-dicke-regime"}, {"concept": "carrier-transition", "prereq": "sideband-couplings"}, {"concept": "red-sideband-jaynes-cummings", "prereq": "sideband-couplings"}, {"concept": "red-sideband-jaynes-cummings", "prereq": "jaynes-cummings-model"}, {"concept": "trapped-ion-strong-coupling", "prereq": "red-sideband-jaynes-cummings"}, {"concept": "trapped-ion-strong-coupling", "prereq": "strong-coupling-regime"}, {"concept": "anti-jaynes-cummings", "prereq": "red-sideband-jaynes-cummings"}, {"concept": "standing-wave-couplings", "prereq": "sideband-couplings"}, {"concept": "sideband-cooling", "prereq": "sideband-couplings"}, {"concept": "sideband-cooling", "prereq": "optical-pumping"}, {"concept": "resolved-sideband-condition", "prereq": "sideband-cooling"}, {"concept": "motional-state-engineering", "prereq": "ion-hilbert-space"}, {"concept": "motional-state-engineering", "prereq": "probability-amplitude"}, {"concept": "pulse-sequence-unitary", "prereq": "motional-state-engineering"}, {"concept": "pulse-sequence-unitary", "prereq": "time-evolution-operator"}, {"concept": "pulse-sequence-unitary", "prereq": "carrier-transition"}, {"concept": "pulse-sequence-unitary", "prereq": "red-sideband-jaynes-cummings"}, {"concept": "internal-motional-swap", "prereq": "pulse-sequence-unitary"}, {"concept": "internal-motional-swap", "prereq": "pulse-area"}, {"concept": "motional-state-preparation", "prereq": "internal-motional-swap"}, {"concept": "ion-string", "prereq": "trapped-ion-model"}, {"concept": "two-ion-motion", "prereq": "ion-string"}, {"concept": "two-ion-motion", "prereq": "motional-hamiltonian"}, {"concept": "ion-normal-modes", "prereq": "two-ion-motion"}, {"concept": "two-ion-laser-hamiltonian", "prereq": "ion-normal-modes"}, {"concept": "two-ion-laser-hamiltonian", "prereq": "lamb-dicke-hamiltonian"}, {"concept": "qubit", "prereq": "two-level-atom"}, {"concept": "qubit", "prereq": "superposition"}, {"concept": "universal-gate-set", "prereq": "qubit"}, {"concept": "pi-phase-gate", "prereq": "universal-gate-set"}, {"concept": "phase-gate-requirements", "prereq": "pi-phase-gate"}, {"concept": "phase-gate-requirements", "prereq": "sideband-cooling"}, {"concept": "phase-gate-requirements", "prereq": "two-ion-laser-hamiltonian"}, {"concept": "ion-trap-phase-gate", "prereq": "phase-gate-requirements"}, {"concept": "ion-trap-phase-gate", "prereq": "internal-motional-swap"}]}