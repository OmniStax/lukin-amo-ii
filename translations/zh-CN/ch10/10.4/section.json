 "derivations": [
  {
   "id": "two-ion-expansion",
   "what": "平衡位置附近两个离子的运动",
   "source": "现代原子与光学物理 II，10.4 离子阱量子计算，10.4.1",
   "nodes": [
    {
     "assumes": [
      {
       "text": "离子位于阱轴上$\\krdist_i = \\langle\\krdist_i\\rangle + \\kxdisp_i$处，其中$\\langle\\krdist_1\\rangle = -\\kasep/2$和$\\langle\\krdist_2\\rangle = \\kasep/2$。",
       "src": "10.4.1"
      },
      {
       "text": "位移$\\kxdisp_i$很小，所以略去它们二阶以上的项。",
       "src": "10.4.1"
      },
      {
       "text": "在平衡位置，阱对每个离子的拉力$\\km\\knu^2\\kasep/2$与库仑斥力$e^2/4\\pi\\epsilon_0\\kasep^2$相平衡。",
       "src": "10.4.1"
      }
     ],
     "then": {
      "tex": "\\mk{H}{\\kH_{motion}} = \\mk{p}{\\sum_i\\frac{\\kpcm_i^2}{2\\km}} + \\mk{t}{\\sum_i\\frac{\\km}{2}\\knu^2\\krdist_i^2} + \\mk{c}{\\frac{e^2}{4\\pi\\epsilon_0|\\krdist_1 - \\krdist_2|}}",
      "src": "(10.31)",
      "uses": []
     },
     "steps": [
      {
       "tex": "\\mk{H}{\\kH_{motion}} = \\mk{p}{\\sum_i\\frac{\\kpcm_i^2}{2\\km}} + \\mk{t}{\\frac{\\km\\knu^2}{2}\\left((\\kxdisp_1 - \\kasep/2)^2 + (\\kxdisp_2 + \\kasep/2)^2\\right)} + \\mk{c}{\\frac{e^2}{4\\pi\\epsilon_0(\\kasep + \\kxdisp_2 - \\kxdisp_1)}}",
       "uses": [
        0
       ]
      },
      {
       "tex": "\\mk{H}{\\kH_{motion}} \\approx \\mk{p}{\\sum_i\\frac{\\kpcm_i^2}{2\\km}} + \\mk{t}{\\frac{\\km\\knu^2}{2}\\left((\\kxdisp_1 - \\kasep/2)^2 + (\\kxdisp_2 + \\kasep/2)^2\\right)} + \\mk{c}{\\frac{e^2}{4\\pi\\epsilon_0\\kasep}\\left(1 - \\frac{\\kxdisp_2 - \\kxdisp_1}{\\kasep} + \\frac{(\\kxdisp_2 - \\kxdisp_1)^2}{\\kasep^2}\\right)}",
       "uses": [
        1
       ],
       "cap": "$\\frac{1}{a + u} \\approx \\frac{1}{a}\\left(1 - \\frac{u}{a} + \\frac{u^2}{a^2}\\right)$，当$u = x_2 - x_1$很小时。"
      },
      {
       "tex": "\\mk{H}{\\kH_{motion}} \\approx \\mk{p}{\\sum_i\\frac{\\kpcm_i^2}{2\\km}} + \\mk{t}{\\frac{\\km\\knu^2}{2}(\\kxdisp_1^2 + \\kxdisp_2^2)} + \\mk{l}{\\left(\\frac{\\km\\knu^2\\kasep}{2} - \\frac{e^2}{4\\pi\\epsilon_0\\kasep^2}\\right)(\\kxdisp_2 - \\kxdisp_1)} + \\mk{c}{\\frac{e^2}{4\\pi\\epsilon_0\\kasep^3}(\\kxdisp_2 - \\kxdisp_1)^2}",
       "uses": [],
       "cap": "展开并略去常数项，它们不影响运动。",
       "map": {
        "t": [
         "t",
         "l"
        ],
        "c": [
         "l",
         "c"
        ]
       }
      },
      {
       "tex": "\\mk{H}{\\kH_{motion}} = \\mk{p}{\\sum_i\\frac{\\kpcm_i^2}{2\\km}} + \\mk{t}{\\frac{\\km\\knu^2}{2}\\left(\\kxdisp_1^2 + \\kxdisp_2^2 + (\\kxdisp_2 - \\kxdisp_1)^2\\right)}",
       "uses": [
        2
       ],
       "cap": "平衡条件$m\\nu^2a/2 = e^2/4\\pi\\epsilon_0a^2$消去线性项，并把$e^2/4\\pi\\epsilon_0a^3$变成$m\\nu^2/2$。",
       "map": {
        "l": "t",
        "c": "t"
       }
      }
     ],
     "num": "(10.32)"
    }
   ]
  },
  {
