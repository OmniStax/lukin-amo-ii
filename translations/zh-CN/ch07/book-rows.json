 "concepts": [
  {
   "id": "instantaneous-eigenstates",
   "kind": "definition",
   "section": "7.1",
   "name": "瞬时本征态",
   "terms": [
    "瞬时本征态"
   ],
   "type": "state",
   "statement": "在任一给定时刻 t₀，哈密顿量 Ĥ(t₀) 具有瞬时本征态 |ϵ_k(t₀)⟩ 和本征值 ϵ_k(t₀)，任意态都可以按它们展开。",
   "forms": [
    {
     "id": "eq-7-1",
     "latex": "\\hat{H}(t_0)|\\epsilon_k(t_0)\\rangle = \\epsilon_k(t_0)|\\epsilon_k(t_0)\\rangle",
     "anchor": "7.1-eq-7-1"
    },
    {
     "id": "eq-7-2",
     "latex": "|\\psi(t)\\rangle = \\sum_l c_l(t)|\\epsilon_l(t)\\rangle",
     "anchor": "7.1-eq-7-2"
    }
   ]
  },
  {
   "id": "nonadiabatic-coupling",
   "kind": "result",
   "section": "7.1",
   "name": "本征态变化引起的耦合",
   "terms": [
    "非对角耦合"
   ],
   "statement": "瞬时本征态的时间依赖性通过非对角项 −iℏ⟨ϵ_k|ϵ̇_l⟩ 耦合它们的概率幅，所以含时哈密顿量的本征态一般不是定态。",
   "forms": [
    {
     "id": "eq-7-4",
     "latex": "i\\hbar\\dot{c}_k(t) = \\epsilon_k(t)c_k(t) - i\\hbar\\sum_l c_l(t)\\langle\\epsilon_k(t)|\\frac{d}{dt}|\\epsilon_l(t)\\rangle",
     "anchor": "7.1-drv-adiabatic-amplitudes"
    },
    {
     "id": "eq-7-6",
     "latex": "i\\hbar\\frac{d}{dt}\\begin{pmatrix} c_1 \\\\ c_2 \\\\ \\vdots \\\\ c_N \\end{pmatrix} = \\begin{pmatrix} \\epsilon_1 & -i\\hbar\\langle\\epsilon_1|\\dot{\\epsilon}_2\\rangle & \\ldots & \\\\ -i\\hbar\\langle\\epsilon_2|\\dot{\\epsilon}_1\\rangle & \\epsilon_2 & & \\\\ \\vdots & & \\ddots & \\\\ & & & \\epsilon_N \\end{pmatrix}\\begin{pmatrix} c_1 \\\\ c_2 \\\\ \\vdots \\\\ c_N \\end{pmatrix}",
     "anchor": "7.1-eq-7-6"
    }
   ]
  },
  {
   "id": "adiabatic-theorem",
   "kind": "result",
   "section": "7.1",
   "name": "绝热定理",
   "terms": [
    "绝热",
    "绝热定理",
    "绝热跟随"
   ],
   "statement": "制备在变化得足够缓慢的哈密顿量的某一瞬时本征态上的系统，在演化中仍处于该本征态：这就是绝热极限，此时泄漏到其他态的布居可忽略。"
  },
  {
   "id": "adiabaticity-condition",
   "kind": "result",
   "section": "7.1",
   "name": "绝热条件",
   "terms": [
    "绝热条件"
   ],
   "statement": "当与每个其他本征态的耦合 ℏ|⟨ϵ_l|ϵ̇_k⟩| 同它们的能量差相比很小时，该瞬时本征态是定态；在时标 τ 上变化的哈密顿量给出 ∝ 1/τ 的耦合。",
   "forms": [
    {
     "id": "eq-7-10",
     "latex": "\\hbar\\frac{|\\langle\\epsilon_l|\\dot{\\epsilon}_k\\rangle|}{|\\epsilon_k - \\epsilon_l|} \\ll 1",
     "anchor": "7.1-drv-adiabatic-condition"
    },
    {
     "id": "eq-7-9",
     "latex": "|\\psi^{(1)}\\rangle = -i\\hbar\\sum_l\\frac{\\langle\\epsilon_l|\\dot{\\epsilon}_k\\rangle|\\epsilon_l\\rangle}{\\epsilon_k - \\epsilon_l}",
     "anchor": "7.1-drv-adiabatic-condition"
    }
   ]
  },
  {
   "id": "dynamical-phase",
   "kind": "definition",
   "section": "7.1",
   "name": "动力学相位",
   "terms": [
    "动力学"
   ],
   "type": "phase",
   "statement": "动力学相位 e^{−i/ℏ∫ϵ_k dτ} 来自薛定谔方程的对角部分。",
   "forms": [
    {
     "id": "eq-7-dynamical-phase",
     "latex": "e^{-\\frac{i}{\\hbar}\\int_0^t d\\tau\\,\\epsilon_k(\\tau)}",
     "anchor": "7.1-phases"
    }
   ]
  },
  {
   "id": "geometric-phase",
   "kind": "definition",
   "section": "7.1",
   "name": "几何相位",
   "terms": [
    "几何",
    "贝里"
   ],
   "type": "phase",
   "statement": "即使满足绝热条件，被忽略的对角项 ⟨ϵ_k|ϵ̇_k⟩ 仍可能引入几何相位或贝里相位，加到动力学相位上。"
  },
  {
   "id": "mixing-angle",
   "kind": "definition",
   "section": "7.2",
   "name": "混合角",
   "symbol": "theta",
   "terms": [
    "混合角"
   ],
   "type": "phase",
   "statement": "混合角 θ 决定二能级系统的缀饰态各含有每个裸态的多少；它由拉比频率与失谐之比确定。",
   "forms": [
    {
     "id": "eq-7-16",
     "latex": "\\theta(t) = -\\frac{1}{2}\\mathrm{arctan}\\,\\frac{2\\Omega(t)}{\\Delta(t)}",
     "anchor": "7.2-eq-7-16"
    }
   ]
  },
  {
   "id": "time-dependent-dressed-states",
   "kind": "result",
   "section": "7.2",
   "name": "含时缀饰态",
   "terms": [
    "含时缀饰态"
   ],
   "type": "state",
   "statement": "对于失谐和拉比频率含时的二能级系统，瞬时本征态 |±⟩ 和本征能量 ϵ± 是一组含时缀饰态和缀饰能量。",
   "forms": [
    {
     "id": "eq-7-13",
     "latex": "|+\\rangle = \\cos\\theta(t)|1\\rangle + \\sin\\theta(t)|2\\rangle",
     "anchor": "7.2-eq-7-13"
    },
    {
     "id": "eq-7-14",
     "latex": "|-\\rangle = \\sin\\theta(t)|1\\rangle - \\cos\\theta(t)|2\\rangle",
     "anchor": "7.2-eq-7-14"
    },
    {
     "id": "eq-7-15",
     "latex": "\\epsilon_\\pm(t) = \\frac{\\hbar}{2}\\left(-\\Delta(t) \\pm \\sqrt{\\Delta(t)^2 + 4\\Omega(t)^2}\\right)",
     "anchor": "7.2-eq-7-15"
    },
    {
     "id": "eq-7-11",
     "latex": "\\hat{H}(t) = -\\hbar\\Delta(t)|2\\rangle\\langle 2| - \\hbar\\Omega(t)\\left(|1\\rangle\\langle 2| + |2\\rangle\\langle 1|\\right)",
     "anchor": "7.2-eq-7-11"
    }
   ]
  },
  {
   "id": "adiabatic-return",
   "kind": "idea",
   "section": "7.2",
   "name": "绝热返回",
   "terms": [
    "绝热返回"
   ],
   "statement": "失谐保持恒定且非零时，脉冲 Ω(t) 使绝热跟随 |−⟩ 的系统进入 |1⟩ 与 |2⟩ 的叠加，并在脉冲结束时回到其初态 |1⟩。"
  },
  {
   "id": "rapid-adiabatic-passage",
   "kind": "result",
   "section": "7.2",
   "name": "快速绝热通道",
   "terms": [
    "快速绝热通道",
    "绝热通道",
    "快速"
   ],
   "statement": "在送入脉冲的同时使失谐以啁啾方式扫过共振，系统沿回避交叉从 |1⟩ 被带到 |2⟩，概率接近 1，且对不精确的 Δ、Ω 和 τ 很稳健；它可以快于激发态寿命，因此称为“快速”。"
  },
  {
   "id": "two-level-adiabaticity-condition",
   "kind": "result",
   "section": "7.2",
   "name": "二能级系统的绝热条件",
   "statement": "当 ℏθ̇ 与分裂 ϵ₊ − ϵ₋ ≥ 2ℏΩ 相比很小时，二能级系统跟随 |−⟩；对于通道，这相当于脉冲面积 A ≫ 1 和最短时间 τ ≈ 1/Ω。",
   "forms": [
    {
     "id": "eq-7-19",
     "latex": "\\hbar\\dot{\\theta}(t) \\ll |\\epsilon_+(t) - \\epsilon_-(t)|",
     "anchor": "7.2-drv-two-level-adiabaticity"
    },
    {
     "id": "eq-7-17",
     "latex": "\\frac{|\\dot{\\Omega}\\Delta - \\Omega\\dot{\\Delta}|}{4\\Omega^2 + \\Delta^2} \\ll \\sqrt{4\\Omega^2 + \\Delta^2}",
     "anchor": "7.2-eq-7-17"
    },
    {
     "id": "eq-7-18",
     "latex": "\\langle\\dot{+}|-\\rangle = \\dot{\\theta}(t)",
     "anchor": "7.2-drv-two-level-adiabaticity"
    },
    {
     "id": "eq-7-20",
     "latex": "\\int_{-\\infty}^{\\infty} dt\\,\\dot{\\theta}(t) \\ll \\int_{-\\infty}^{\\infty} dt\\, 2\\Omega(t) = A",
     "anchor": "7.2-drv-pulse-area-condition"
    }
   ]
  },
  {
   "id": "landau-zener",
   "kind": "result",
   "section": "7.2",
   "name": "朗道-齐纳模型",
   "symbol": "P_LZ",
   "terms": [
    "朗道-齐纳模型"
   ],
   "type": "population",
   "statement": "对于恒定的 Ω₀ 和线性扫描的失谐 Δ = αt，完全转移的概率为 P_LZ = 1 − e^{−2π|Ω₀|²/|α|}；其非绝热修正在小参数中不是解析的，不能用微扰论求得。",
   "forms": [
    {
     "id": "eq-7-22",
     "latex": "P_{LZ} = 1 - e^{-2\\pi\\frac{|\\Omega_0|^2}{|\\alpha|}}",
     "anchor": "7.2-eq-7-22"
    },
    {
     "id": "eq-7-23",
     "latex": "P_{LZ} - 1 \\approx e^{-\\frac{\\pi}{2}\\frac{1}{\\epsilon}}",
     "anchor": "7.2-eq-7-23"
    },
    {
     "id": "eq-7-21",
     "latex": "\\epsilon = \\frac{\\dot{\\theta}}{|\\epsilon_+ - \\epsilon_-|}",
     "anchor": "7.2-eq-7-21"
    }
   ]
  },
  {
   "id": "three-level-dressed-states",
   "kind": "result",
   "section": "7.3",
   "name": "三能级系统的缀饰态",
   "type": "state",
   "statement": "在双光子共振处，三能级哈密顿量具有缀饰态 |Φ±⟩ 和 |Φ₀⟩；|Φ₀⟩ 的能量为零且与 |3⟩ 的内积为零，是暗态，是由 tan θ = Ω₁/Ω₂ 确定的 |1⟩ 与 |2⟩ 的叠加。",
   "forms": [
    {
     "id": "eq-7-26",
     "latex": "|\\Phi_0\\rangle = \\cos\\theta|1\\rangle - \\sin\\theta|2\\rangle",
     "anchor": "7.3-drv-lambda-dressed-states"
    },
    {
     "id": "eq-7-28",
     "latex": "\\tan\\theta = \\frac{\\Omega_1}{\\Omega_2}",
     "anchor": "7.3-drv-lambda-dressed-states"
    },
    {
     "id": "eq-7-24",
     "latex": "\\hat{H} = -\\Delta|3\\rangle\\langle 3| - \\Omega_1\\left(|3\\rangle\\langle 1| + |1\\rangle\\langle 3|\\right) - \\Omega_2\\left(|3\\rangle\\langle 2| + |2\\rangle\\langle 3|\\right)",
     "anchor": "7.3-eq-7-24"
    },
    {
     "id": "eq-7-25",
     "latex": "|\\Phi_+\\rangle = \\sin\\theta\\sin\\phi|1\\rangle + \\cos\\theta\\sin\\phi|2\\rangle + \\cos\\phi|3\\rangle",
     "anchor": "7.3-drv-lambda-dressed-states"
    },
    {
     "id": "eq-7-27",
     "latex": "|\\Phi_-\\rangle = \\sin\\theta\\cos\\phi|1\\rangle + \\cos\\theta\\cos\\phi|2\\rangle - \\sin\\phi|3\\rangle",
     "anchor": "7.3-drv-lambda-dressed-states"
    },
    {
     "id": "eq-7-29",
     "latex": "\\tan 2\\phi = -\\frac{\\sqrt{|\\Omega_1|^2 + |\\Omega_2|^2}}{\\Delta} = -\\frac{\\Omega}{\\Delta}",
     "anchor": "7.3-drv-lambda-dressed-states"
    },
    {
     "id": "eq-7-30",
     "latex": "\\epsilon_+ = \\frac{1}{2}\\left(-\\Delta + \\sqrt{\\Omega^2 + \\Delta^2}\\right)",
     "anchor": "7.3-drv-lambda-dressed-states"
    },
    {
     "id": "eq-7-31",
     "latex": "\\epsilon_0 = 0",
     "anchor": "7.3-drv-lambda-dressed-states"
    },
    {
     "id": "eq-7-32",
     "latex": "\\epsilon_- = \\frac{1}{2}\\left(-\\Delta - \\sqrt{\\Omega^2 + \\Delta^2}\\right)",
     "anchor": "7.3-drv-lambda-dressed-states"
    }
   ]
  },
  {
   "id": "stirap",
   "kind": "result",
   "section": "7.3",
   "name": "受激拉曼绝热通道",
   "terms": [
    "受激拉曼绝热通道",
    "STIRAP"
   ],
   "statement": "用反直觉脉冲序列把混合角从 0 缓慢扫到 π/2，可把暗态从 |1⟩ 带到 −|2⟩，而从不布居 |3⟩；这种转移对脉冲形状和定时以及单光子失谐都很稳健，但对双光子失谐敏感。",
   "forms": [
    {
     "id": "eq-7-33",
     "latex": "\\theta = 0 \\quad \\Rightarrow \\quad |\\Phi_0\\rangle = |1\\rangle",
     "anchor": "7.3-eq-7-33"
    },
    {
     "id": "eq-7-34",
     "latex": "\\theta = \\frac{\\pi}{2} \\quad \\Rightarrow \\quad |\\Phi_0\\rangle = -|2\\rangle",
     "anchor": "7.3-eq-7-34"
    }
   ]
  },
  {
   "id": "four-level-dark-states",
   "kind": "result",
   "section": "7.3",
   "name": "四能级暗态",
   "terms": [
    "四能级系统"
   ],
   "type": "state",
   "statement": "共振耦合到同一个激发态的三个亚稳态有两个简并暗态；因为它们简并，其非绝热耦合可用来制备任意叠加 c₃|3⟩ + c₄|4⟩，由第三个场的相位和振幅确定。",
   "forms": [
    {
     "id": "eq-7-35",
     "latex": "|\\Phi_1\\rangle = \\cos\\theta|1\\rangle - \\sin\\theta\\cos\\phi|3\\rangle - \\sin\\theta\\sin\\phi|4\\rangle",
     "anchor": "7.3-drv-tripod-dark-states"
    },
    {
     "id": "eq-7-36",
     "latex": "|\\Phi_2\\rangle = \\sin\\phi|3\\rangle - \\cos\\phi|4\\rangle",
     "anchor": "7.3-drv-tripod-dark-states"
    },
    {
     "id": "eq-7-37",
     "latex": "\\tan\\theta = \\frac{\\Omega_1}{\\sqrt{|\\Omega_3|^2 + |\\Omega_4|^2}}",
     "anchor": "7.3-drv-tripod-dark-states"
    },
    {
     "id": "eq-7-38",
     "latex": "\\tan\\phi = \\frac{\\Omega_3}{\\Omega_4}",
     "anchor": "7.3-drv-tripod-dark-states"
    }
   ]
  },
  {
   "id": "adiabatic-atomic-beamsplitter",
   "kind": "idea",
   "section": "7.3",
   "name": "原子的绝热分束器",
   "terms": [
    "原子分束器",
    "原子分束器"
   ],
   "statement": "穿过三束空间上分开的光束的原子被绝热地转移到 |3⟩ 与 |4⟩ 的可控混合，二者不同的动量冲击把内态映射到位置上：原子分束器。"
  },
  {
   "id": "dark-state-adiabaticity-condition",
   "kind": "result",
   "section": "7.4",
   "name": "有衰变时的绝热条件",
   "statement": "存在来自激发态的衰变 γ₁₃ 时，暗态跟随的一阶修正按 γ₁₃/Ω²τ 标度，所以绝热跟随要求 γ₁₃/Ω²τ ≪ 1，这与相干演化的条件大不相同。",
   "forms": [
    {
     "id": "eq-7-53",
     "latex": "\\frac{\\gamma_{13}}{\\Omega^2\\tau} \\ll 1",
     "anchor": "7.4-eq-7-53"
    },
    {
     "id": "eq-7-39",
     "latex": "\\Omega_1(t) = \\Omega\\sin\\frac{t}{\\tau}",
     "anchor": "7.4-eq-7-39"
    },
    {
     "id": "eq-7-40",
     "latex": "\\Omega_2(t) = \\Omega\\cos\\frac{t}{\\tau}",
     "anchor": "7.4-eq-7-40"
    },
    {
     "id": "eq-7-41",
     "latex": "\\dot{c}_1 = i\\Omega_1^*(t)c_3",
     "anchor": "7.4-eq-7-41"
    },
    {
     "id": "eq-7-42",
     "latex": "\\dot{c}_2 = i\\Omega_2^*(t)c_3",
     "anchor": "7.4-eq-7-42"
    },
    {
     "id": "eq-7-43",
     "latex": "\\dot{c}_3 = -\\gamma_{13}c_3 + i\\left(\\Omega_1(t)c_1 + \\Omega_2(t)c_2\\right)",
     "anchor": "7.4-eq-7-43"
    },
    {
     "id": "eq-7-51",
     "latex": "c_3^{(1)} = \\frac{\\dot{c}_1^{(0)}}{i\\Omega_1^*} = \\frac{i}{\\Omega\\tau}",
     "anchor": "7.4-drv-stirap-first-order"
    }
   ]
  },
  {
   "id": "adiabatic-expansion",
   "kind": "skill",
   "section": "7.4",
   "name": "绝热展开",
   "statement": "将概率幅按正比于 1/τ 的小参数的幂展开：零阶是忽略时间导数的定态解，每一阶修正由前一阶的时间导数驱动。",
   "forms": [
    {
     "id": "eq-7-44",
     "latex": "c_i = c_i^{(0)} + c_i^{(1)} + \\ldots",
     "anchor": "7.4-eq-7-44"
    },
    {
     "id": "eq-7-55",
     "latex": "\\dot{v}^{(0)} \\approx M(t/\\tau)\\left(v^{(0)} + v^{(1)}\\right)"
    }
   ]
  },
  {
   "id": "quantum-jump-error",
   "kind": "result",
   "section": "7.4",
   "name": "量子跳跃引起的误差",
   "type": "population",
   "statement": "在时间 τ 内量子跳跃的概率为 γ₁₃/Ω²τ，所以非厄米演化与绝热近似在相同的情形下成立。",
   "forms": [
    {
     "id": "eq-7-56",
     "latex": "P_\\mathrm{jump} = \\gamma_{13}\\int_0^\\tau |c_3|^2 = \\frac{\\gamma_{13}}{\\Omega^2\\tau}",
     "anchor": "7.4-eq-7-56"
    },
    {
     "id": "eq-7-57",
     "latex": "P_\\mathrm{jump} \\ll 1 \\Rightarrow \\frac{\\gamma_{13}}{\\Omega^2\\tau} \\ll 1",
     "anchor": "7.4-eq-7-57"
    }
   ]
  },
  {
   "id": "stirap-fidelity",
   "kind": "result",
   "section": "7.4",
   "name": "有衰变时绝热通道的保真度",
   "type": "population",
   "statement": "末态为 −|2⟩ 的概率为 ρ₂₂ = e^{−πγ₁₃/2|Ω|²τ}，与朗道-齐纳结果不同，它允许按小参数 γ₁₃/Ω²τ 展开。",
   "forms": [
    {
     "id": "eq-7-58",
     "latex": "\\rho_{22} = e^{-\\frac{\\pi\\gamma_{13}}{2|\\Omega|^2\\tau}}",
     "anchor": "7.4-drv-stirap-fidelity"
    }
   ]
  },
  {
   "id": "bright-dark-basis",
   "kind": "definition",
   "section": "7.4",
   "name": "部分对角化基",
   "terms": [
    "部分对角化基"
   ],
   "type": "state",
   "statement": "暗态 |D⟩、亮态 |B⟩ 和激发态 |E⟩ 构成一个部分对角化基，其中只有 |B⟩ 与 |E⟩ 耦合，拉比频率为 √(|Ω₁|² + |Ω₂|²)。",
   "forms": [
    {
     "id": "eq-7-59",
     "latex": "|B\\rangle = \\frac{\\Omega_1|1\\rangle + \\Omega_2|2\\rangle}{\\sqrt{|\\Omega_1|^2 + |\\Omega_2|^2}}",
     "anchor": "7.4-eq-7-59"
    },
    {
     "id": "eq-7-60",
     "latex": "|D\\rangle = \\frac{\\Omega_2|1\\rangle - \\Omega_1|2\\rangle}{\\sqrt{|\\Omega_1|^2 + |\\Omega_2|^2}}",
     "anchor": "7.4-eq-7-60"
    },
    {
     "id": "eq-7-61",
     "latex": "|E\\rangle = |3\\rangle",
     "anchor": "7.4-eq-7-61"
    },
    {
     "id": "eq-7-62",
     "latex": "\\hat{H}_\\mathrm{int} = -\\sqrt{|\\Omega_1|^2 + |\\Omega_2|^2}\\left(|B\\rangle\\langle E| + |E\\rangle\\langle B|\\right)",
     "anchor": "7.4-eq-7-62"
    }
   ]
  },
  {
   "id": "nonadiabatic-rabi-frequency",
   "kind": "definition",
   "section": "7.4",
   "name": "暗态与亮态的非绝热耦合",
   "symbol": "Omega_NA",
   "terms": [
    "非绝热耦合"
   ],
   "type": "coupling",
   "statement": "有限的脉冲时间把 |D⟩ 耦合到 |B⟩，如同拉比频率为 Ω_NA = 1/τ 的弱场。",
   "forms": [
    {
     "id": "eq-7-63",
     "latex": "i\\hbar\\langle B|\\frac{d}{dt}|D\\rangle = -i\\hbar\\frac{1}{\\tau}",
     "anchor": "7.4-eq-7-63"
    }
   ]
  },
  {
   "id": "bright-state-escape-rate",
   "kind": "result",
   "section": "7.4",
   "name": "亮态的逃逸率",
   "symbol": "gamma_B",
   "type": "rate",
   "statement": "向 |E⟩ 的激发及其衰变赋予 |B⟩ 有限寿命，逃逸率为 γ_B = Ω²/γ₁₃；当 1/τ ≪ Ω²/γ₁₃ 时原子保持为暗，这与由物理推理得到的是同一个绝热条件。",
   "forms": [
    {
     "id": "eq-7-64",
     "latex": "\\gamma_B = \\frac{\\Omega^2}{\\gamma_{13}}",
     "anchor": "7.4-eq-7-64"
    },
    {
     "id": "eq-7-65",
     "latex": "\\frac{1}{\\tau} \\ll \\frac{\\Omega^2}{\\gamma_{13}}",
     "anchor": "7.4-eq-7-65"
    }
   ]
  },
  {
   "id": "adiabatic-following-eit",
   "kind": "idea",
   "section": "7.4",
   "name": "绝热跟随与 EIT",
   "statement": "只有当探测脉冲长于暗共振谱线宽度的倒数，τ ≫ γ₁₃/Ω² 时，它才能无损耗地在 EIT 介质中传播，这恰好就是绝热跟随条件：脉冲经过时，原子跟随暗态进入又退出。"
  },
  {
   "id": "dark-state-optical-pumping",
   "kind": "idea",
   "section": "7.4",
   "name": "光抽运制备暗态",
   "terms": [
    "非绝热暗态制备"
   ],
   "statement": "混合态不能通过任何哈密顿量演化变为暗态，但在亮态与暗态基中的光抽运通过纯粹非相干的过程制备出它：从 |B⟩ 激发的原子衰变到 |D⟩ 并留在那里。"
  },
