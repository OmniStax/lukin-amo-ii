 "concepts": [
  {
   "id": "multiphoton-process-classes",
   "kind": "idea",
   "section": "5.1",
   "name": "多光子过程的分类",
   "terms": [
    "非相干相互作用",
    "相干相互作用",
    "参量相互作用"
   ],
   "statement": "多光子过程大致分为三类：非相干相互作用，其中原子相干性不重要；相干相互作用，其中原子相干性起作用，且需要两个或更多光子来产生它们；以及参量相互作用，其中光与原子之间没有能量交换，但原子介导光束之间的相互作用。"
  },
  {
   "id": "raman-transition",
   "kind": "idea",
   "section": "5.1",
   "name": "拉曼跃迁",
   "terms": [
    "拉曼跃迁",
    "双光子拉曼跃迁",
    "双光子拉曼跃迁"
   ],
   "statement": "在拉曼跃迁中，两个光子经由一个激发态激励一个偶极禁戒跃迁：通过在跃迁 ν₁ 上吸收一个光子并发射一个频率为 ν₂ 的光子，布居在两个基态之间被相干地转移。"
  },
  {
   "id": "three-level-configurations",
   "kind": "definition",
   "section": "5.1",
   "name": "三能级构型",
   "terms": [
    "级联系统",
    "V 型系统",
    "级联",
    "V 型"
   ],
   "statement": "双光子跃迁发生在三能级的三种构型中：Λ 型系统，其中单个激发态介导两个下态之间的跃迁；级联系统，经由一个居间态向上攀升；以及 V 型系统，两个激发态共用一个基态。"
  },
  {
   "id": "lambda-system",
   "kind": "definition",
   "section": "5.1",
   "name": "Λ 型系统",
   "terms": [
    "Λ 型系统",
    "Λ 型系统",
    "三能级 Λ 型系统"
   ],
   "type": "state",
   "statement": "在 Λ 型系统中，单个激发态 |3⟩ 介导两个下态之间的跃迁；到 |3⟩ 的跃迁是偶极容许的，衰变很快，而 |2⟩ → |1⟩ 是偶极禁戒的，因此亚稳态 |2⟩ 可以有非常长的寿命。"
  },
  {
   "id": "lambda-detunings",
   "kind": "definition",
   "section": "5.1",
   "name": "单光子失谐与双光子失谐",
   "symbol": "Delta_1",
   "terms": [
    "单光子失谐",
    "双光子失谐",
    "单光子失谐"
   ],
   "type": "frequency",
   "statement": "单光子失谐 Δ₁ 和 Δ₂ 是每个场相对于其到 |3⟩ 的跃迁来度量的，双光子失谐是它们的差。",
   "forms": [
    {
     "id": "eq-5-detunings",
     "latex": "\\delta = \\Delta_1 - \\Delta_2",
     "anchor": "5.1-detunings"
    }
   ]
  },
  {
   "id": "lambda-hamiltonian",
   "kind": "result",
   "section": "5.1",
   "name": "Λ 型系统哈密顿量",
   "type": "energy",
   "statement": "在适当的转动参考系中，将 |1⟩ 的能量取为零，Λ 型系统的哈密顿量的对角线上含有失谐，对角线外含有两个拉比频率。",
   "forms": [
    {
     "id": "eq-5-1",
     "latex": "\\hat{H} = -\\Delta_1|3\\rangle\\langle 3| - \\delta|2\\rangle\\langle 2| - \\left(\\Omega_1|3\\rangle\\langle 1| + \\Omega_2|3\\rangle\\langle 2| + \\Omega_1^*|1\\rangle\\langle 3| + \\Omega_2^*|2\\rangle\\langle 3|\\right)",
     "anchor": "5.1-eq-5-1"
    }
   ]
  },
  {
   "id": "lambda-equations-of-motion",
   "kind": "result",
   "section": "5.1",
   "name": "Λ 型系统运动方程",
   "symbol": "c_3",
   "type": "amplitude",
   "statement": "忽略衰变时，态 c₁|1⟩ + c₂|2⟩ + c₃|3⟩ 服从 Λ 型系统哈密顿量的薛定谔方程，由此得到三个概率幅的运动方程。",
   "forms": [
    {
     "id": "eq-5-2",
     "latex": "|\\psi\\rangle = c_1(t)|1\\rangle + c_2(t)|2\\rangle + c_3(t)|3\\rangle",
     "anchor": "5.1-eq-5-2"
    },
    {
     "id": "eq-5-3",
     "latex": "\\dot{c}_1 = i\\Omega_1^* c_3",
     "anchor": "5.1-eq-5-3"
    },
    {
     "id": "eq-5-4",
     "latex": "\\dot{c}_2 = i\\delta c_2 + i\\Omega_2^* c_3",
     "anchor": "5.1-eq-5-4"
    },
    {
     "id": "eq-5-5",
     "latex": "\\dot{c}_3 = i\\Delta_1 c_3 + i\\Omega_1 c_1 + i\\Omega_2 c_2",
     "anchor": "5.1-eq-5-5"
    }
   ]
  },
  {
   "id": "effective-raman-coupling",
   "kind": "result",
   "section": "5.1",
   "name": "有效双光子拉比频率",
   "symbol": "Omega_eff",
   "terms": [
    "有效拉比频率"
   ],
   "type": "coupling",
   "statement": "对于大而相近的单光子失谐 Δ ≫ Ω₁, Ω₂, γ₃, δ，激发态概率幅被消去，两个下能级表现得像一个由有效拉比频率耦合的二能级系统，每个能级的斯塔克偏移为 |Ω_i|²/Δ。",
   "forms": [
    {
     "id": "eq-5-9",
     "latex": "\\Omega_\\mathrm{eff} = -\\frac{\\Omega_2^*\\Omega_1}{\\Delta}",
     "anchor": "5.1-drv-raman-coupling"
    },
    {
     "id": "eq-5-6",
     "latex": "c_3 = -\\frac{\\Omega_1 c_1 + \\Omega_2 c_2}{\\Delta}",
     "anchor": "5.1-drv-raman-coupling"
    },
    {
     "id": "eq-5-7",
     "latex": "\\dot{c}_1 = -i\\frac{|\\Omega_1|^2}{\\Delta}c_1 - i\\frac{\\Omega_2\\Omega_1^*}{\\Delta}c_2",
     "anchor": "5.1-drv-raman-coupling"
    },
    {
     "id": "eq-5-8",
     "latex": "\\dot{c}_2 = i(\\delta - \\frac{|\\Omega_2|^2}{\\Delta})c_2 - i\\frac{\\Omega_1\\Omega_2^*}{\\Delta}c_1",
     "anchor": "5.1-drv-raman-coupling"
    }
   ]
  },
  {
   "id": "lambda-density-matrix-equations",
   "kind": "result",
   "section": "5.1",
   "name": "Λ 型系统密度矩阵方程",
   "statement": "为了计入衰变和退相位，用密度矩阵处理 Λ 型系统：刘维尔算符包含从 |3⟩ 到 |1⟩ 和 |2⟩ 以及从 |2⟩ 到 |1⟩ 的衰变，每个相干性 ρ_ij 以其自身的速率 γ_ij 衰变。",
   "forms": [
    {
     "id": "eq-5-10",
     "latex": "\\dot{\\rho} = \\mathcal{L}_{31}(\\rho) + \\mathcal{L}_{32}(\\rho) + i[\\hat{H}, \\rho]",
     "anchor": "5.1-eq-5-10"
    },
    {
     "id": "eq-5-11",
     "latex": "\\mathcal{L}_{31} = -\\frac{\\gamma_{3\\rightarrow 1}}{2}\\left(\\sigma_{31}\\sigma_{13}\\rho - \\sigma_{13}\\rho\\sigma_{31} + h.c.\\right)",
     "anchor": "5.1-eq-5-11"
    },
    {
     "id": "eq-5-12",
     "latex": "\\dot{\\rho}_{11} = -i\\Omega_1\\rho_{13} + i\\Omega_1^*\\rho_{31} + \\gamma\\rho_{33} + \\gamma'\\rho_{22}",
     "anchor": "5.1-drv-lambda-density-matrix"
    },
    {
     "id": "eq-5-13",
     "latex": "\\dot{\\rho}_{22} = -i\\Omega_2\\rho_{23} + i\\Omega_2^*\\rho_{32} - \\gamma'\\rho_{22} + \\tilde{\\gamma}\\rho_{33}",
     "anchor": "5.1-drv-lambda-density-matrix"
    },
    {
     "id": "eq-5-14",
     "latex": "\\dot{\\rho}_{21} = -\\left(\\gamma_{12} - i\\delta\\right)\\rho_{21} + i\\Omega_2^*\\rho_{31} - i\\Omega_1\\rho_{23}",
     "anchor": "5.1-drv-lambda-density-matrix"
    },
    {
     "id": "eq-5-15",
     "latex": "\\dot{\\rho}_{31} = -\\left(\\gamma_{13} - i\\Delta\\right)\\rho_{31} + i\\Omega_2\\rho_{21} + i\\Omega_1\\left(\\rho_{11} - \\rho_{33}\\right)",
     "anchor": "5.1-drv-lambda-density-matrix"
    },
    {
     "id": "eq-5-16",
     "latex": "\\dot{\\rho}_{32} = -\\left(\\gamma_{23} - i(\\Delta - \\delta)\\right)\\rho_{32} + i\\Omega_2\\left(\\rho_{22} - \\rho_{33}\\right) + i\\Omega_1\\rho_{12}",
     "anchor": "5.1-drv-lambda-density-matrix"
    }
   ]
  },
  {
   "id": "complex-decay-rate",
   "kind": "definition",
   "section": "5.1",
   "name": "复衰变参量",
   "symbol": "Gamma_12",
   "terms": [
    "复衰变参量",
    "复衰变率"
   ],
   "type": "rate",
   "statement": "每个相干性的相位演化和衰变一并用一个复衰变参量表示，其实部是衰变率，虚部是失谐。",
   "forms": [
    {
     "id": "eq-5-17",
     "latex": "\\Gamma_{12} = \\gamma_{12} - i\\delta",
     "anchor": "5.1-eq-5-17"
    },
    {
     "id": "eq-5-18",
     "latex": "\\Gamma_{13} = \\gamma_{13} - i\\Delta",
     "anchor": "5.1-eq-5-18"
    },
    {
     "id": "eq-5-19",
     "latex": "\\Gamma_{23} = \\gamma_{23} - i(\\Delta - \\delta)",
     "anchor": "5.1-eq-5-19"
    }
   ]
  },
  {
   "id": "lambda-non-hermitian-evolution",
   "kind": "result",
   "section": "5.1",
   "name": "Λ 型系统的随机波函数处理",
   "symbol": "gamma_3",
   "type": "rate",
   "statement": "来自 |3⟩ 和 |2⟩ 的衰变进入一个非厄米哈密顿量，只要量子跳跃的概率保持很小，就可以使用它的薛定谔方程：对于从 |1⟩ 开始的弱探测光，或者 |2⟩ 的衰变缓慢且激发态布居很少的情形。",
   "forms": [
    {
     "id": "eq-5-21",
     "latex": "\\hat{H}_\\mathrm{eff} = \\hat{H} - \\frac{i\\hbar\\gamma_3}{2}|3\\rangle\\langle 3| - \\frac{i\\hbar\\gamma_2}{2}|2\\rangle\\langle 2|",
     "anchor": "5.1-eq-5-21"
    },
    {
     "id": "eq-5-22",
     "latex": "P_\\mathrm{jump} = \\int dt\\left(\\gamma_2|c_2(t)|^2 + \\gamma_3|c_3(t)|^2\\right) \\ll 1",
     "anchor": "5.1-eq-5-22"
    },
    {
     "id": "eq-5-23",
     "latex": "\\dot{c}_1 = i\\Omega_1^* c_3",
     "anchor": "5.1-eq-5-23"
    },
    {
     "id": "eq-5-24",
     "latex": "\\dot{c}_2 = -(\\frac{\\gamma_2}{2} - i\\delta)c_2 + i\\Omega_2^* c_3",
     "anchor": "5.1-eq-5-24"
    },
    {
     "id": "eq-5-25",
     "latex": "\\dot{c}_3 = -(\\frac{\\gamma_3}{2} - i\\Delta_1)c_3 + i\\Omega_1 c_1 + i\\Omega_2 c_2",
     "anchor": "5.1-eq-5-25"
    }
   ]
  },
  {
   "id": "weak-probe-solution",
   "kind": "result",
   "section": "5.1",
   "name": "Λ 型系统的弱探测定常态",
   "statement": "对于弱探测光 Ω₁ 和强度任意的恒定 Ω₂，系统在 Ω₁ 的零阶下保持在 |1⟩，对运动方程作傅里叶变换，就得到双光子相干和光学相干。",
   "forms": [
    {
     "id": "eq-5-29",
     "latex": "\\rho_{21} = c_1^* c_2 = -\\frac{\\Omega_1\\Omega_2^*}{\\Gamma_{12}\\Gamma_{13} + |\\Omega_2|^2}",
     "anchor": "5.1-drv-weak-probe-coherences"
    },
    {
     "id": "eq-5-30",
     "latex": "\\rho_{31} = c_1^* c_3 = i\\Omega_1\\frac{\\Gamma_{12}}{\\Gamma_{12}\\Gamma_{13} + |\\Omega_2|^2}",
     "anchor": "5.1-drv-weak-probe-coherences"
    },
    {
     "id": "eq-5-26",
     "latex": "(\\frac{\\gamma_2}{2} - i(\\delta - \\omega))c_2 = i\\Omega_2^* c_3",
     "anchor": "5.1-eq-5-26"
    },
    {
     "id": "eq-5-27",
     "latex": "(\\frac{\\gamma_3}{2} - i(\\Delta_1 - \\omega))c_3 = i\\Omega_1 + i\\Omega_2 c_2",
     "anchor": "5.1-eq-5-27"
    },
    {
     "id": "eq-5-28",
     "latex": "\\rho_{11} = |c_1|^2 = 1",
     "anchor": "5.1-drv-weak-probe-coherences"
    }
   ]
  },
  {
   "id": "probe-susceptibility",
   "kind": "definition",
   "section": "5.1",
   "name": "探测跃迁上的线性电极化率",
   "symbol": "chi_1",
   "terms": [
    "线性电极化率"
   ],
   "type": "susceptibility",
   "statement": "当探测光很弱时，系统的响应由探测跃迁上的线性电极化率表征，它正比于 ρ₃₁/Ω₁。",
   "forms": [
    {
     "id": "eq-5-31",
     "latex": "\\chi_1 = \\frac{|\\mu|^2}{\\hbar\\epsilon_0}\\frac{\\rho_{31}}{\\Omega_1}",
     "anchor": "5.1-eq-5-31"
    },
    {
     "id": "eq-5-32",
     "latex": "\\frac{\\rho_{31}}{\\Omega_1} = \\frac{i}{\\Gamma_{13}}\\left(\\frac{\\Gamma_{12}}{\\Gamma_{12} + |\\Omega_2|^2/\\Gamma_{13}}\\right)",
     "anchor": "5.1-drv-probe-response"
    },
    {
     "id": "eq-5-33",
     "latex": "\\frac{\\rho_{31}}{\\Omega_1} = \\frac{i}{\\Gamma_{13}}\\left(1 - \\frac{|\\Omega_2|^2/\\Gamma_{13}}{\\Gamma_{12} + |\\Omega_2|^2/\\Gamma_{13}}\\right)",
     "anchor": "5.1-drv-probe-response"
    }
   ]
  },
  {
   "id": "two-photon-resonance",
   "kind": "result",
   "section": "5.1",
   "name": "双光子共振",
   "symbol": "gamma_eff",
   "terms": [
    "双光子共振"
   ],
   "type": "rate",
   "statement": "在大 Δ 时，探测电极化率除了宽度为 γ₁₃ 的宽单光子共振之外，还显示出一个移至 δ = |Ω₂|²/Δ 的窄双光子共振；它的宽度由亚稳态退相干 γ₁₂ 和一个被失谐强烈抑制的激发态项决定。",
   "forms": [
    {
     "id": "eq-5-35",
     "latex": "\\frac{\\rho_{31}}{\\Omega_1} - \\frac{i}{\\Gamma_{13}} \\approx \\frac{i|\\Omega_2|^2/\\Delta^2}{\\gamma_\\mathrm{eff} - i\\delta'}",
     "anchor": "5.1-drv-raman-resonance"
    },
    {
     "id": "eq-5-34",
     "latex": "\\frac{\\rho_{31}}{\\Omega_1} - \\frac{i}{\\Gamma_{13}} \\approx \\frac{i|\\Omega_2|^2/\\Delta^2}{\\Gamma_{12} + (|\\Omega_2|^2/\\Delta^2)(\\gamma_{13} + i\\Delta)}",
     "anchor": "5.1-drv-raman-resonance"
    }
   ]
  },
  {
   "id": "two-photon-detuning-shifted",
   "kind": "definition",
   "section": "5.1",
   "name": "有效双光子失谐",
   "symbol": "delta_prime",
   "type": "frequency",
   "statement": "双光子共振的有效失谐是双光子失谐减去 |2⟩ 的光致频移。",
   "forms": [
    {
     "id": "eq-5-delta-prime",
     "latex": "\\delta' = \\delta - |\\Omega_2|^2/\\Delta",
     "anchor": "5.1-drv-raman-resonance"
    }
   ]
  },
  {
   "id": "raman-unitarity-limit",
   "kind": "result",
   "section": "5.1",
   "name": "幺正极限处的双光子共振",
   "terms": [
    "幺正极限"
   ],
   "statement": "恰好处于双光子共振且没有退相位时，电极化率就是辐射增宽的系统的电极化率，趋近幺正极限，双光子峰与单光子共振具有相同的振幅。",
   "forms": [
    {
     "id": "eq-5-36",
     "latex": "\\frac{\\rho_{31}}{\\Omega_1} \\sim \\frac{2i}{\\gamma_3}",
     "anchor": "5.1-eq-5-36"
    }
   ]
  },
  {
   "id": "raman-dressed-states",
   "kind": "result",
   "section": "5.1",
   "name": "拉曼共振的缀饰态图像",
   "statement": "强场 Ω₂ 缀饰 |2⟩ 和 |3⟩；单光子共振是向 |+⟩ 的跃迁，|+⟩ 几乎是 |3⟩，宽度几乎是它的辐射宽度，而双光子拉曼共振是向 |−⟩ 的跃迁，其宽度是它的退相位率。",
   "forms": [
    {
     "id": "eq-5-37",
     "latex": "|+\\rangle \\approx |3\\rangle - \\frac{\\Omega_2^*}{\\Delta}|2\\rangle",
     "anchor": "5.1-eq-5-37"
    },
    {
     "id": "eq-5-38",
     "latex": "|-\\rangle \\approx |2\\rangle + \\frac{\\Omega_2}{\\Delta}|3\\rangle",
     "anchor": "5.1-eq-5-38"
    },
    {
     "id": "eq-5-39",
     "latex": "\\gamma_- \\approx \\gamma_{12} + \\frac{|\\Omega_2|^2}{\\Delta^2}\\gamma_{13}",
     "anchor": "5.1-eq-5-39"
    }
   ]
  },
  {
   "id": "two-photon-rabi-oscillations",
   "kind": "result",
   "section": "5.1",
   "name": "双光子拉比振荡",
   "terms": [
    "双光子拉比振荡"
   ],
