       }
      },
      {
       "tex": "\\mk{a}{\\kcone(\\kt)} = \\mk{z}{\\kaone},\\quad \\mk{b}{\\kctwo(\\kt)} = \\mk{R}{\\katwo e^{-(\\kgamma/2+i\\kDelta)\\kt}}",
       "uses": [
