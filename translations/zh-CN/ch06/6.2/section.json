      {
       "text": "未发生跳跃的原子的态，是演化后的态除以其模。",
       "src": "(6.17)"
      }
     ],
     "then": {
      "tex": "\\mk{L}{\\frac{d}{d\\kt}|\\kpsi\\rangle} = \\mk{R}{-\\left(\\frac{\\kgamma}{2} + i\\kDelta\\right)|2\\rangle\\langle 2|\\kpsi\\rangle}",
      "uses": []
     },
     "steps": [
      {
       "tex": "\\mk{L}{\\dot{\\kcone}|1\\rangle + \\dot{\\kctwo}|2\\rangle} = \\mk{R}{-\\left(\\frac{\\kgamma}{2} + i\\kDelta\\right)\\kctwo|2\\rangle}",
       "uses": [],
       "cap": "写成$|\\psi\\rangle = c_1|1\\rangle + c_2|2\\rangle$，于是$\\langle 2|\\psi\\rangle = c_2$。"
      },
      {
       "tex": "\\mk{a}{\\dot{\\kcone}} = \\mk{z}{0},\\quad \\mk{b}{\\dot{\\kctwo}} = \\mk{R}{-\\left(\\frac{\\kgamma}{2} + i\\kDelta\\right)\\kctwo}",
