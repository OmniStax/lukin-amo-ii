       "map": {
        "L": [
         "c",
         "s"
        ],
        "R": [
         "c",
         "s"
        ]
       }
      },
      {
       "tex": "\\mk{c}{(\\kvmag/\\kvc)B = 1 - A},\\qquad \\mk{s}{(\\kvmag/\\kvc)A = B}",
       "uses": [],
       "cap": "把俘获速度记为$v_c = 1/2k\\tau_P$。"
      },
      {
       "tex": "\\mk{c}{A = \\frac{1}{1 + (\\kvmag/\\kvc)^2}},\\qquad \\mk{s}{B = \\frac{\\kvmag/\\kvc}{1 + (\\kvmag/\\kvc)^2}}",
       "uses": []
      },
      {
       "tex": "\\mk{D}{\\kDeltarho} = \\mk{c}{\\frac{1}{1 + (\\kvmag/\\kvc)^2}\\cos(2\\kkmag z)} + \\mk{s}{\\frac{\\kvmag/\\kvc}{1 + (\\kvmag/\\kvc)^2}\\sin(2\\kkmag z)}",
