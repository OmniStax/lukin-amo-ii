     "then": {
      "tex": "\\mk{L}{\\frac{d}{d\\kt}\\kDeltarho} = \\mk{R}{-\\frac{1}{\\ktauP}\\left(\\kDeltarho - \\cos(2\\kkmag\\kvmag\\kt)\\right)}",
      "src": "(8.117)",
      "uses": []
     },
     "steps": [
      {
       "tex": "\\mk{L}{2\\kkmag\\kvmag\\ktauP\\left(-A\\sin(2\\kkmag\\kvmag\\kt) + B\\cos(2\\kkmag\\kvmag\\kt)\\right)} = \\mk{R}{(1 - A)\\cos(2\\kkmag\\kvmag\\kt) - B\\sin(2\\kkmag\\kvmag\\kt)}",
       "uses": [
        0
       ],
       "cap": "乘以$\\tau_P$并代入试探解。"
      },
