       "tex": "\\mk{T}{k_B\\kTS} = \\mk{a}{\\frac{\\kDdiff_{sp} + \\kDdiff_{dp}}{\\km|\\ketaS|}} \\approx \\mk{R}{\\frac{3(\\hbar\\kkmag)^2|\\kOmega|^2/8\\kgamma}{3\\hbar\\kkmag^2|\\kdelta|/\\kgamma}}",
       "uses": [
        3,
        4,
        5
       ]
      },
      {
       "tex": "\\mk{T}{k_B\\kTS} = \\mk{a}{\\frac{\\kDdiff_{sp} + \\kDdiff_{dp}}{\\km|\\ketaS|}} \\approx \\mk{R}{\\frac{\\hbar|\\kOmega|^2}{8|\\kdelta|}}",
       "uses": []
