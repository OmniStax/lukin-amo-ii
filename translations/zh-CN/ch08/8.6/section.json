       "step": 0
      },
      {
       "tex": "\\frac{1}{\\ktauP} = \\frac{2}{9}\\kRopt",
       "src": "(8.113)"
      },
      {
       "text": "波矢量为$k = 2\\pi/\\lambda$。",
       "src": "8.1"
      }
     ],
     "then": {
      "tex": "\\mk{v}{\\kvc} = \\mk{R}{\\frac{1}{2\\kkmag\\ktauP}}",
