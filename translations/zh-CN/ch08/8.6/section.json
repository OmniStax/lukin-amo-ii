      "why": "解中所命名的俘获速度。"
     },
     "steps": [
      {
       "tex": "\\mk{v}{\\kvc} = \\mk{R}{\\frac{1}{2\\kkmag\\ktauP}} = \\mk{a}{\\frac{2\\kRopt}{9\\cdot 2\\kkmag}}",
       "uses": [
        1
       ]
      },
      {
       "tex": "\\mk{v}{\\kvc} = \\mk{R}{\\frac{1}{2\\kkmag\\ktauP}} = \\mk{a}{\\frac{\\klambda}{18\\pi}\\kRopt}",
       "uses": [
        2
