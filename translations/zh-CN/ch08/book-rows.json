     "latex": "\\Omega_+ = \\Omega\\cos kz, \\quad \\Omega_- = \\Omega\\sin kz",
     "anchor": "8.6-eq-8-103"
    }
   ]
  },
  {
   "id": "sisyphus-cooling",
   "kind": "idea",
   "section": "8.6",
   "name": "西西弗斯冷却",
   "terms": [
    "西西弗斯"
   ],
   "statement": "局域偏振把运动的原子光抽运到光致频移后较低的子能级，所以它不断爬坡，并把势能损失给自发光子。"
  },
  {
   "id": "sisyphus-pumping-rate",
   "kind": "result",
   "section": "8.6",
   "name": "基态子能级间的光抽运",
   "symbol": "tau_P",
   "type": "time",
   "statement": "基态布居的速率方程使布居差 Δρ 以速率 1/τ_P = (2/9)R_opt 弛豫到其局域定常值 cos 2kz。",
   "forms": [
    {
     "id": "eq-8-113",
     "latex": "\\frac{1}{\\tau_P} = \\frac{2}{9}R_\\mathrm{opt}",
     "anchor": "8.6-drv-population-relaxation"
    },
    {
     "id": "eq-8-110",
     "latex": "\\frac{d}{dt}\\rho_{\\frac{1}{2}\\frac{1}{2}} = -\\frac{2}{9}R_\\mathrm{opt}\\sin^2(kz)\\rho_{\\frac{1}{2}\\frac{1}{2}} + \\frac{2}{9}R_\\mathrm{opt}\\cos^2(kz)\\rho_{-\\frac{1}{2}-\\frac{1}{2}}",
     "anchor": "8.6-eq-8-110"
    },
    {
     "id": "eq-8-112",
     "latex": "\\frac{d}{dt}\\Delta\\rho = -\\frac{2}{9}R_\\mathrm{opt}\\left(\\Delta\\rho - \\cos(2kz)\\right)",
     "anchor": "8.6-drv-population-relaxation"
    },
    {
     "id": "eq-8-114",
     "latex": "\\Delta\\rho_{SS} = \\cos(2kz)",
     "anchor": "8.6-drv-population-relaxation"
    }
   ]
  },
  {
   "id": "sisyphus-force",
   "kind": "result",
   "section": "8.6",
   "name": "西西弗斯冷却力",
   "type": "force",
   "statement": "若布居跟随其定常态，基态子能级上的反应力平均为零；运动原子的布居滞后 τ_P，给出依赖速度的平均力。",
   "forms": [
    {
     "id": "eq-8-122",
     "latex": "\\langle F\\rangle = \\frac{2}{3}\\hbar k^2v\\tau_P\\frac{|\\Omega|^2}{\\delta}",
     "anchor": "8.6-drv-lag-force"
    },
    {
     "id": "eq-8-109",
     "latex": "F_\\mathrm{reactive} = \\frac{2}{3}\\hbar k\\frac{|\\Omega|^2}{\\delta}\\sin(2kz)\\left(|\\tfrac{1}{2}\\rangle\\langle\\tfrac{1}{2}| - |-\\tfrac{1}{2}\\rangle\\langle -\\tfrac{1}{2}|\\right)",
     "anchor": "8.6-drv-sisyphus-reactive-force"
    },
    {
     "id": "eq-8-116",
     "latex": "F^{SS}_\\mathrm{reactive} = \\frac{1}{3}\\hbar k\\frac{|\\Omega|^2}{\\delta}\\sin(4kz)",
     "anchor": "8.6-drv-steady-state-force"
    },
    {
     "id": "eq-8-117",
     "latex": "\\frac{d}{dt}\\Delta\\rho = -\\frac{1}{\\tau_P}\\left(\\Delta\\rho - \\cos(2kvt)\\right)",
     "anchor": "8.6-eq-8-117"
    },
    {
     "id": "eq-8-120",
     "latex": "\\Delta\\rho \\approx \\cos 2k(z - v\\tau_P)",
     "anchor": "8.6-drv-population-lag"
    }
   ]
  },
  {
   "id": "sisyphus-friction",
   "kind": "result",
   "section": "8.6",
   "name": "西西弗斯摩擦系数",
   "symbol": "eta_S",
   "type": "friction",
   "statement": "精确求解滞后的布居，得到俘获速度 v_c = 1/2kτ_P 的平均力，在低功率下摩擦系数 η_S = 3(ℏk²/m)(δ/γ)，与光强无关。",
   "forms": [
    {
     "id": "eq-8-127",
     "latex": "\\eta_S = 3\\frac{\\hbar k^2}{m}\\frac{\\delta}{\\gamma}",
     "anchor": "8.6-eq-8-127"
    },
    {
     "id": "eq-8-125",
     "latex": "\\langle F_\\mathrm{reactive}\\rangle = \\frac{1}{3}\\hbar k\\frac{|\\Omega|^2}{\\delta}\\frac{v/v_c}{1 + (v/v_c)^2} = \\eta_Svm",
     "anchor": "8.6-drv-sisyphus-solution"
    },
    {
     "id": "eq-8-124",
     "latex": "v_c = \\frac{1}{2k\\tau_P} = \\frac{\\lambda}{18\\pi}R_\\mathrm{opt}",
     "anchor": "8.6-drv-sisyphus-solution"
    },
    {
     "id": "eq-8-123",
     "latex": "\\Delta\\rho = \\frac{1}{1 + (v/v_c)^2}\\cos(2kz) + \\frac{v/v_c}{1 + (v/v_c)^2}\\sin(2kz)",
     "anchor": "8.6-drv-sisyphus-solution"
    },
    {
     "id": "eq-8-126",
     "latex": "\\eta_S = 3\\frac{\\hbar k^2}{m}\\frac{\\delta}{\\gamma}\\left(\\frac{1}{1 + (v/v_c)^2}\\right)",
     "anchor": "8.6-drv-sisyphus-friction"
    }
   ]
  },
  {
   "id": "doppler-sisyphus-comparison",
   "kind": "result",
   "section": "8.6",
   "name": "多普勒冷却与西西弗斯冷却的比较",
   "statement": "在低功率和大失谐下，多普勒摩擦按 |Ω|²/δ³ 趋于零，而西西弗斯摩擦随 δ 增长，但西西弗斯俘获速度随抽运率 |Ω|²γ/δ² 缩小。",
   "forms": [
    {
     "id": "eq-8-128",
     "latex": "\\eta_D = 8\\frac{\\hbar k^2}{m}\\frac{\\gamma_{12}|\\Omega|^2}{\\delta^3}",
     "anchor": "8.6-eq-8-128"
    },
    {
     "id": "eq-8-129",
     "latex": "\\eta_S = 3\\frac{\\hbar k^2}{m\\gamma}\\delta",
     "anchor": "8.6-eq-8-129"
    },
    {
     "id": "eq-8-130",
     "latex": "v^S_c \\sim \\frac{\\lambda}{18\\pi}\\frac{|\\Omega|^2}{\\delta^2}\\gamma",
     "anchor": "8.6-eq-8-130"
    }
   ]
  },
  {
   "id": "sisyphus-nonadiabaticity",
   "kind": "idea",
   "section": "8.6",
   "name": "西西弗斯冷却中的非绝热性",
   "statement": "西西弗斯冷却需要布居滞后于原子的位置：绝热跟随它的布居在下坡得到的，正是在上坡失去的。"
  },
  {
   "id": "sisyphus-limit",
   "kind": "result",
   "section": "8.6",
   "name": "西西弗斯冷却极限",
   "symbol": "T_S",
   "type": "temperature",
   "statement": "自发冲击和涨落偶极力的扩散，通过爱因斯坦关系与 η_S 相平衡，得到 k_BT_S ≈ ℏ|Ω|²/8δ：与光致频移势的深度同量级。",
   "forms": [
    {
     "id": "eq-8-133",
     "latex": "k_BT_S = \\frac{D_{sp} + D_{dp}}{m|\\eta_S|} \\approx \\frac{\\hbar|\\Omega|^2}{8\\delta}",
     "anchor": "8.6-drv-sisyphus-limit"
    },
    {
     "id": "eq-8-131",
     "latex": "D_{sp} = (\\hbar k)^2\\frac{|\\Omega|^2\\gamma/2}{(\\gamma/2)^2 + \\delta^2}",
     "anchor": "8.6-eq-8-131"
    },
    {
     "id": "eq-8-132",
     "latex": "D_{dp} = \\left\\langle 2\\hbar^2k^2\\frac{\\delta^2}{\\gamma}\\frac{\\Omega^2/2}{\\delta^2 + (\\gamma/2)^2}\\sin^4(2kz)\\right\\rangle = \\frac{3(\\hbar k)^2\\delta^2}{4\\gamma}\\frac{\\Omega^2/2}{\\delta^2 + (\\gamma/2)^2}",
     "anchor": "8.6-eq-8-132"
    }
   ]
  },
  {
   "id": "recoil-limit",
   "kind": "result",
   "section": "8.6",
   "name": "反冲极限",
   "symbol": "T_R",
   "type": "temperature",
   "statement": "局域在一个势阱中的原子，动量不确定度为 2πℏ/λ 量级，所以经典分析止于反冲能 ℏω_R，它远低于多普勒极限。",
   "forms": [
    {
     "id": "eq-8-135",
     "latex": "E^\\mathrm{kinetic}_\\mathrm{min} \\sim \\hbar\\omega_R",
     "anchor": "8.6-eq-8-135"
    },
    {
     "id": "eq-8-134",
     "latex": "\\delta p \\approx \\frac{2\\pi\\hbar}{\\lambda}",
     "anchor": "8.6-eq-8-134"
    }
   ]
  },
  {
   "id": "sub-recoil-cooling",
   "kind": "idea",
   "section": "8.6",
   "name": "亚反冲冷却",
   "terms": [
    "亚反冲"
   ],
   "statement": "冷却到 ω_R 以下需要对运动作量子处理，并使用双光子跃迁或暗共振。"
  },
  {
   "id": "laser-cooling",
   "kind": "idea",
   "section": "8.1",
   "name": "激光冷却",
   "terms": [
    "激光冷却"
   ],
   "statement": "光能冷却原子：它的力不仅使原子减速，还使其速度分布变窄，直到由每种方案的加热所设的极限。"
  }
