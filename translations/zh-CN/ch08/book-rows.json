 "concepts": [
  {
   "id": "moving-atom-hamiltonian",
   "kind": "definition",
   "section": "8.1",
   "name": "运动原子的哈密顿量",
   "symbol": "H",
   "type": "energy",
   "statement": "在激光中运动的原子的哈密顿量，把质心动能 p̂²/2m 与外部势 V(r̂) 加到场项和原子-场项上，并且在旋转波近似下，激光耦合 Ω(r̂) = |Ω(r̂)|e^{iφ(r̂)} 依赖于位置算符。",
   "forms": [
    {
     "id": "eq-8-1",
     "latex": "\\hat{H} = \\hat{H}_F + \\hat{H}_{AF} + \\frac{\\hat{p}^2}{2m} + V(\\hat{r})",
     "anchor": "8.1-eq-8-1"
    },
    {
     "id": "eq-8-2",
     "latex": "\\hat{H}_{AL} = -\\hbar\\Omega(\\hat{r})|2\\rangle\\langle 1| - \\hbar\\Omega(\\hat{r})^*|1\\rangle\\langle 2|",
     "anchor": "8.1-eq-8-2"
    },
    {
     "id": "eq-8-3",
     "latex": "\\Omega(\\hat{r}) = |\\Omega(\\hat{r})|e^{i\\phi(\\hat{r})}",
     "anchor": "8.1-eq-8-3"
    }
   ]
  },
  {
   "id": "atomic-recoil",
   "kind": "result",
   "section": "8.1",
   "name": "原子反冲",
   "terms": [
    "原子反冲"
   ],
   "type": "momentum",
   "statement": "相位为 k·r 的平面波把 |p⟩|1⟩ 耦合到 |p + ℏk⟩|2⟩：吸收一个光子使原子的质心动量改变 ℏk，同时也改变其内态。",
   "forms": [
    {
     "id": "eq-8-6",
     "latex": "\\hat{H}_{AL} = -\\hbar|\\Omega(\\hat{r})| \\int \\left(|2\\rangle|p + \\hbar k\\rangle\\langle p|\\langle 1| + |1\\rangle|p\\rangle\\langle p + \\hbar k|\\langle 2|\\right) dp",
     "anchor": "8.1-drv-plane-wave-coupling"
    },
    {
     "id": "eq-8-5",
     "latex": "e^{ik\\cdot\\hat{r}} = \\int dp'|p' + \\hbar k\\rangle\\langle p'|",
     "anchor": "8.1-drv-plane-wave-coupling"
    }
   ]
  },
  {
   "id": "recoil-frequency",
   "kind": "definition",
   "section": "8.1",
   "name": "反冲频率",
   "terms": [
    "反冲能",
    "反冲移位"
   ],
   "symbol": "omega_R",
   "type": "frequency",
   "statement": "反冲频率 ω_R 是受一个光子冲击的原子的动能 (ℏk)²/2m 除以 ℏ。",
   "forms": [
    {
     "id": "eq-8-recoil-frequency",
     "latex": "\\hbar\\omega_R = \\frac{(\\hbar k)^2}{2m}",
     "anchor": "8.2-recoil-energy"
    }
   ]
  },
  {
   "id": "recoil-shifted-resonance",
   "kind": "result",
   "section": "8.1",
   "name": "共振的多普勒频移与反冲移位",
   "terms": [
    "多普勒频移"
   ],
   "type": "frequency",
   "statement": "跃迁 |p⟩|1⟩ → |p + ℏk⟩|2⟩ 在 ω₁₂ 经多普勒频移 pk/m = vk 和反冲移位 ℏk²/2m 移动后的频率处共振。",
   "symbol": "omega_res",
   "forms": [
    {
     "id": "eq-8-8",
     "latex": "\\omega_\\mathrm{res} = \\omega_{12} + \\frac{pk}{m} + \\frac{\\hbar k^2}{2m}",
     "anchor": "8.1-drv-recoil-shifted-resonance"
    },
    {
     "id": "eq-8-7",
     "latex": "\\omega_\\mathrm{res} = \\omega_{12} + \\frac{(p + \\hbar k)^2}{2m\\hbar} - \\frac{p^2}{2m\\hbar}",
     "anchor": "8.1-drv-recoil-shifted-resonance"
    }
   ]
  },
  {
   "id": "light-force-operator",
   "kind": "result",
   "section": "8.2",
   "name": "力算符",
   "symbol": "F",
   "type": "force",
   "statement": "在海森伯绘景中，原子所受的力是其动量与哈密顿量的对易式，对于激光耦合为 ℏ∇Ω|2⟩⟨1| + h.c.。",
   "forms": [
    {
     "id": "eq-8-10",
     "latex": "\\hat{F} = -[\\nabla, \\hat{H}(\\hat{r})] = \\hbar\\nabla\\Omega|2\\rangle\\langle 1| + \\hbar\\nabla\\Omega^*|1\\rangle\\langle 2|",
     "anchor": "8.2-drv-light-force-operator"
    },
    {
     "id": "eq-8-9",
     "latex": "\\frac{d}{dt}\\hat{p} = \\frac{1}{i\\hbar}[\\hat{p}, \\hat{H}] = \\hat{F}",
     "anchor": "8.2-eq-8-9"
    },
    {
     "id": "eq-8-13",
     "latex": "[\\hat{p}, \\hat{O}(r)] = -i\\hbar\\nabla\\hat{O}(r)",
     "anchor": "8.2-force-operator"
    }
   ]
  },
  {
   "id": "semiclassical-light-force",
   "kind": "result",
   "section": "8.2",
   "name": "反应光力与耗散光力",
   "terms": [
    "半经典",
    "反应性的",
    "耗散性的"
   ],
   "symbol": "F_mag",
   "type": "force",
   "statement": "把原子当作感受平均力的经典小球，光力分为来自相位梯度和 Im(ρ₂₁/Ω) 的耗散部分，以及来自强度梯度和 Re(ρ₂₁/Ω) 的反应部分。",
   "forms": [
    {
     "id": "eq-8-18",
     "latex": "F = 2\\hbar|\\Omega|^2\\nabla\\phi\\ \\mathrm{Im}\\left(\\frac{\\rho_{21}}{\\Omega}\\right) + \\hbar\\nabla|\\Omega|^2\\mathrm{Re}\\left(\\frac{\\rho_{21}}{\\Omega}\\right)",
     "anchor": "8.2-drv-semiclassical-light-force"
    },
    {
     "id": "eq-8-14",
     "latex": "F = \\langle\\hat{F}\\rangle = \\hbar\\nabla\\Omega\\rho_{12} + \\hbar\\nabla\\Omega^*\\rho_{21}",
     "anchor": "8.2-drv-semiclassical-light-force"
    },
    {
     "id": "eq-8-15",
     "latex": "\\langle|1\\rangle\\langle 2|\\rangle = \\mathrm{Tr}[\\rho|1\\rangle\\langle 2|] = \\rho_{21}",
     "anchor": "8.2-drv-semiclassical-light-force"
    }
   ]
  },
  {
   "id": "semiclassical-force-validity",
   "kind": "result",
   "section": "8.2",
   "name": "半经典力的有效性",
   "statement": "经典运动的原子所受的定常态力，对于比 1/γ₁₂ 和 1/δ 长、比反冲时间短的时间成立，ω_R ≪ 1/t ≪ max(γ₁₂, δ)。",
   "forms": [
    {
     "id": "eq-8-19",
     "latex": "\\omega_R \\ll 1/t \\ll \\max(\\gamma_{12}, \\delta)",
     "anchor": "8.2-eq-8-19"
    }
   ]
  },
  {
   "id": "dipole-force",
   "kind": "result",
   "section": "8.2",
   "name": "偶极力",
   "terms": [
    "偶极力"
   ],
   "symbol": "V_eff",
   "type": "force",
   "statement": "远离共振时，力是反应性的，即交流斯塔克偏移 ℏ|Ω|²/δ 的梯度；它是保守的，δ < 0 时把原子吸引到场的极大处，δ > 0 时吸引到极小处。",
   "forms": [
    {
     "id": "eq-8-20",
     "latex": "F = -\\hbar\\nabla\\left(\\frac{|\\Omega|^2}{\\delta}\\right)",
     "anchor": "8.2-eq-8-20"
    },
    {
     "id": "eq-8-21",
     "latex": "V_\\mathrm{eff} = \\hbar\\sum_i \\frac{|\\Omega_i|^2}{\\delta_i}|i\\rangle\\langle i|",
     "anchor": "8.2-eq-8-21"
    }
   ]
  },
  {
   "id": "dipole-trap",
   "kind": "idea",
   "section": "8.2",
   "name": "偶极阱",
   "terms": [
    "偶极阱"
   ],
   "statement": "紧聚焦的红失谐光束把原子吸引到其光强最大的区域，并以很少的自发发射把它们束缚住。"
  },
  {
   "id": "optical-lattice",
   "kind": "idea",
   "section": "8.2",
   "name": "光学格子",
   "terms": [
    "光学格子",
    "原子晶体"
   ],
   "statement": "驻波形成周期性偶极势，势阱间隔约 λ/2，正交光束增加维度：原子与光的模型晶体。"
  },
  {
   "id": "dissipative-force",
   "kind": "result",
   "section": "8.2",
   "name": "耗散力",
   "terms": [
    "耗散力"
   ],
   "symbol": "F_force",
   "type": "force",
   "statement": "在平面波中力是耗散的：每吸收一个光子冲击 ℏk，自发光子射入 4π，所以力是 ℏk 乘以散射率，低光强时为 ℏkR_opt，失谐中含多普勒频移 kv。",
   "forms": [
    {
     "id": "eq-8-23",
     "latex": "\\mathbf{F} \\approx \\hbar\\mathbf{k}\\frac{2\\gamma_{12}|\\Omega|^2}{\\gamma_{12}^2 + (\\delta - kv)^2} = \\hbar\\mathbf{k}R_\\mathrm{opt}",
     "anchor": "8.2-drv-dissipative-force"
    },
    {
     "id": "eq-8-24",
     "latex": "\\mathbf{F} = \\hbar\\mathbf{k}\\gamma\\rho_{22}",
     "anchor": "8.2-drv-scattering-force"
    },
    {
     "id": "eq-8-22",
     "latex": "\\mathrm{Im}\\left(\\frac{\\rho_{21}}{\\Omega}\\right) \\approx \\frac{\\gamma_{12}}{\\gamma_{12}^2 + (\\delta - kv)^2}",
     "anchor": "8.2-drv-dissipative-force"
    }
   ]
  },
  {
   "id": "maximum-dissipative-force",
   "kind": "result",
   "section": "8.2",
   "name": "最大耗散力",
   "type": "force",
   "statement": "随着跃迁饱和，耗散力达到 ℏkγ/2，因为原子至多只有一半的时间处于激发态。",
   "forms": [
    {
     "id": "eq-8-27",
     "latex": "\\mathbf{F}_\\mathrm{max} = \\hbar\\mathbf{k}\\frac{\\gamma}{2}",
     "anchor": "8.2-drv-maximum-dissipative-force"
    },
    {
     "id": "eq-8-26",
     "latex": "\\mathbf{F} = \\hbar\\mathbf{k}\\frac{\\gamma R_{opt}}{\\gamma + 2R_{opt}}",
     "anchor": "8.2-drv-maximum-dissipative-force"
    },
    {
     "id": "eq-8-25",
     "latex": "\\mathrm{Im}\\left(\\frac{\\rho_{21}}{\\Omega}\\right) = \\frac{\\gamma_{12}}{\\gamma_{12}^2 + (\\delta - kv)^2}\\frac{\\gamma}{\\gamma + 2R_{opt}}",
     "anchor": "8.2-eq-8-25"
    }
   ]
  },
  {
   "id": "atomic-beam-slowing",
   "kind": "idea",
   "section": "8.2",
   "name": "原子束减速",
   "terms": [
    "啁啾的"
   ],
   "statement": "使原子束减速需要约 10⁴ 次冲击，历时数毫秒、行程约一米；原子的多普勒频移变化时，只有激光有啁啾，或变化的磁场使它产生塞曼移位，原子才保持共振。"
  },
  {
   "id": "doppler-cooling",
   "kind": "idea",
   "section": "8.3",
   "name": "多普勒冷却",
   "terms": [
    "多普勒冷却",
    "冷却"
   ],
   "statement": "冷却需要依赖速度的力，使热原子比冷原子减速更多；多普勒冷却从耗散力中的多普勒频移得到这种力。"
  },
  {
   "id": "zero-velocity-excitation-rate",
   "kind": "definition",
   "section": "8.3",
   "name": "零速度激发率",
   "symbol": "R_opt_0",
   "type": "rate",
   "statement": "R⁰_opt 是静止原子的光激发率，2γ₁₂|Ω|²/(γ₁₂² + δ²)。",
   "forms": [
    {
     "id": "eq-8-zero-velocity-rate",
     "latex": "R_\\mathrm{opt}^0 = \\frac{2\\gamma_{12}|\\Omega|^2}{\\gamma_{12}^2 + \\delta^2}",
     "anchor": "8.3-zero-velocity-rate"
    }
   ]
  },
  {
   "id": "low-velocity-doppler-force",
   "kind": "result",
   "section": "8.3",
   "name": "低速时的多普勒力",
   "type": "force",
   "statement": "对于 k·v ≪ δ, γ₁₂，耗散力是与速度无关的冲击 ℏkR⁰_opt，加上一个含 (k·v) 的项，其符号不依赖于 k 的符号。",
   "forms": [
    {
     "id": "eq-8-28",
     "latex": "F \\approx \\hbar\\mathbf{k}R_\\mathrm{opt}^0\\left(1 + \\frac{2\\delta\\mathbf{k}\\cdot\\mathbf{v}}{\\gamma_{12}^2 + \\delta^2}\\right)",
     "anchor": "8.3-drv-doppler-force-expansion"
    }
   ]
  },
  {
   "id": "friction-coefficient",
   "kind": "definition",
   "section": "8.3",
   "name": "摩擦系数",
   "terms": [
    "摩擦系数",
    "黏性力"
   ],
   "symbol": "eta",
   "type": "friction",
   "statement": "两束对传光束抵消了冲击，只留下黏性力 ηmv_z，摩擦系数 η 正比于 δ：红失谐冷却，蓝失谐加热。",
   "forms": [
    {
     "id": "eq-8-30",
     "latex": "\\eta = \\frac{8\\hbar k^2}{m}\\frac{\\delta\\gamma_{12}|\\Omega|^2}{(\\gamma_{12}^2 + \\delta^2)^2}",
     "anchor": "8.3-drv-friction-coefficient"
    },
    {
     "id": "eq-8-29",
     "latex": "F = F_+ + F_- = \\eta m v_z",
     "anchor": "8.3-eq-8-29"
    }
   ]
  },
  {
   "id": "optical-molasses",
   "kind": "idea",
   "section": "8.3",
   "name": "光学黏团",
   "terms": [
    "光学黏团"
   ],
   "statement": "三对正交的、对传的红失谐光束沿每个轴给出独立的黏性力，在三维上冷却原子。"
  },
  {
   "id": "maximum-friction-coefficient",
   "kind": "result",
   "section": "8.3",
   "name": "最大摩擦系数",
   "type": "friction",
   "statement": "摩擦系数在 δ ∼ γ₁₂ 附近最大，在辐射增宽的谱线上饱和时达到 ω_R/2，所以原子损失动量的速率为反冲频率量级。",
   "forms": [
    {
     "id": "eq-8-33",
     "latex": "\\eta_\\mathrm{max} = \\frac{1}{2}\\omega_R",
     "anchor": "8.3-eq-8-33"
    },
    {
     "id": "eq-8-31",
     "latex": "\\eta = \\frac{\\hbar k^2}{m}\\frac{R_\\mathrm{opt}^0(\\delta = 0)}{\\gamma_{12}}",
     "anchor": "8.3-eq-8-31"
    },
    {
     "id": "eq-8-32",
     "latex": "\\eta \\to \\frac{\\hbar k^2}{8m}\\frac{\\gamma}{\\gamma_{12}}",
     "anchor": "8.3-eq-8-32"
    }
   ]
  },
  {
   "id": "capture-range",
   "kind": "definition",
   "section": "8.3",
   "name": "俘获范围",
   "terms": [
    "俘获范围",
    "临界速度",
    "俘获速度"
   ],
   "symbol": "v_c",
   "type": "velocity",
   "statement": "俘获范围 −v_c < v < v_c 是被有效冷却的速度带，v_c 是力最大处；v_c 约为主导速率（γ₁₂、Ω 或 δ）除以 k。",
   "forms": [
    {
     "id": "eq-8-capture-range",
     "latex": "F_\\mathrm{max} = |F(\\pm v_c)|",
     "anchor": "8.3-capture-range"
    }
   ]
  },
  {
   "id": "magneto-optical-trap",
   "kind": "idea",
   "section": "8.3",
   "name": "磁光阱",
   "terms": [
    "磁光阱",
    "MOT"
   ],
   "statement": "磁场梯度使能级随位置发生塞曼移位，J = 0 → J = 1 跃迁上的交叉圆偏振黏团光束于是把原子推回中心，同时冷却它。"
  },
  {
   "id": "langevin-equation",
   "kind": "definition",
   "section": "8.4",
   "name": "朗之万方程",
   "terms": [
    "朗之万方程",
    "朗之万力",
    "布朗运动"
   ],
   "symbol": "f_t",
   "type": "force",
   "statement": "重粒子的布朗运动是黏滞阻力 −ηp 加上零均值的涨落朗之万力 f(t)，在快速碰撞极限下其关联为 2Dδ(t − t′)。",
   "forms": [
    {
     "id": "eq-8-34",
     "latex": "\\frac{d}{dt}p = -\\eta p + f(t)",
     "anchor": "8.4-eq-8-34"
    },
    {
     "id": "eq-8-35",
     "latex": "\\langle f(t)\\rangle = 0",
     "anchor": "8.4-eq-8-35"
    },
    {
     "id": "eq-8-36",
     "latex": "\\langle f(t)f(t')\\rangle = 2Dg(t-t')",
     "anchor": "8.4-eq-8-36"
    },
    {
     "id": "eq-8-38",
     "latex": "g(t-t') \\rightarrow \\delta(t-t')",
     "anchor": "8.4-eq-8-38"
    }
   ]
  },
  {
   "id": "diffusion-coefficient",
   "kind": "definition",
   "section": "8.4",
   "name": "扩散系数",
   "terms": [
    "扩散系数",
    "扩散常量"
   ],
   "symbol": "D_diff",
   "type": "diffusion",
   "statement": "扩散系数 D 通过 ⟨f(t)f(t′)⟩ = 2Dg(t − t′) 度量涨落力的强度，其中 g 归一化为单位面积。",
   "forms": [
    {
     "id": "eq-8-37",
     "latex": "\\int_{-\\infty}^{\\infty} g(t-t')dt = 1",
     "anchor": "8.4-eq-8-37"
    }
   ]
  },
  {
   "id": "langevin-momentum-spread",
   "kind": "result",
   "section": "8.4",
   "name": "朗之万力下的动量展宽",
   "type": "momentum",
