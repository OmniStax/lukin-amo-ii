 "concepts": [
  {
   "id": "two-level-atom",
   "kind": "definition",
   "section": "2.1",
   "name": "二能级原子",
   "terms": [
    "二能级原子",
    "二能级系统"
   ],
   "type": "state",
   "statement": "当外场较弱且与单一原子跃迁近共振时，原子可以近似为二能级系统，此时只有基态和近共振的激发能级有可观的占据概率。"
  },
  {
   "id": "atomic-transition-frequency",
   "kind": "definition",
   "section": "2.1",
   "name": "原子跃迁频率",
   "symbol": "omega",
   "type": "frequency",
   "statement": "两个原子能级的能量差为 ħω。"
  },
  {
   "id": "slowly-varying-envelope",
   "kind": "definition",
   "section": "2.1",
   "name": "近单色经典场",
   "symbol": "E_env",
   "terms": [
    "缓变包络"
   ],
   "type": "electric-field",
   "statement": "近单色经典场以光频 ν 振荡，带有一个缓变包络，该包络变化的时标远慢于光频，长度尺度远大于光波长。",
   "forms": [
    {
     "id": "eq-2-1",
     "latex": "\\mathbf{E}(\\mathbf{r}, t) = \\mathcal{E}(\\mathbf{r}, t)e^{-i(\\nu t - \\mathbf{k}\\cdot\\mathbf{r})} + \\mathcal{E}(\\mathbf{r}, t)^* e^{i(\\nu t - \\mathbf{k}\\cdot\\mathbf{r})}",
     "anchor": "2.1-eq-2-1"
    }
   ]
  },
  {
   "id": "optical-frequency",
   "kind": "definition",
   "section": "2.1",
   "name": "场的光频",
   "symbol": "nu",
   "type": "frequency",
   "statement": "外加场的角频率 ν，接近原子跃迁频率。"
  },
  {
   "id": "two-level-dipole-operator",
   "kind": "result",
   "section": "2.1",
   "name": "二能级原子的偶极算符",
   "type": "dipole",
   "statement": "截断到不带永久电偶极子的两个相关能级后，偶极算符只通过偶极矩阵元连接这两个态。",
   "forms": [
    {
     "id": "eq-2-dipole",
     "latex": "\\hat{d} = |1\\rangle\\langle 2|\\mu_{1,2} + |2\\rangle\\langle 1|\\mu_{2,1}",
     "anchor": "2.1-eq-dipole"
    }
   ]
  },
  {
   "id": "two-level-hamiltonian",
   "kind": "definition",
   "section": "2.1",
   "name": "经典场中的二能级原子",
   "type": "energy",
   "statement": "二能级原子与经典场的完整哈密顿量，等于激发能级的能量减去原子偶极子与场的耦合。",
   "forms": [
    {
     "id": "eq-2-2",
     "latex": "\\hat{H} = \\hbar\\omega|2\\rangle\\langle 2| - (|1\\rangle\\langle 2|\\mu_{1,2} + |2\\rangle\\langle 1|\\mu_{2,1}) \\cdot \\left(\\mathcal{E}e^{-i\\nu t} + \\mathcal{E}^* e^{i\\nu t}\\right)",
     "anchor": "2.1-eq-2-2"
    }
   ]
  },
  {
   "id": "two-level-equations-of-motion",
   "kind": "result",
   "section": "2.1",
   "name": "二能级运动方程",
   "statement": "把态按自由哈密顿量的本征态展开，薛定谔方程给出概率幅 c₁(t) 和 c₂(t) 的耦合微分方程。",
   "forms": [
    {
     "id": "eq-2-3",
     "latex": "|\\psi\\rangle = c_1(t)|1\\rangle + c_2(t)|2\\rangle",
     "anchor": "2.1-eq-2-3"
    },
    {
     "id": "eq-2-eom",
     "latex": "i\\hbar\\dot{c}_2(t) = \\hbar\\omega\\, c_2(t) - \\left(\\mathcal{E}e^{-i\\nu t} + \\mathcal{E}^* e^{i\\nu t}\\right)\\mu_{21}c_1(t)",
     "anchor": "2.1-drv-rotating-frame-equations"
    }
   ]
  },
  {
   "id": "detuning",
   "kind": "definition",
   "section": "2.1",
   "name": "失谐",
   "symbol": "delta",
   "terms": [
    "失谐",
    "失谐"
   ],
   "type": "frequency",
   "statement": "场的光频与原子跃迁频率之差。",
   "forms": [
    {
     "id": "eq-2-detuning",
     "latex": "\\delta = \\nu - \\omega",
     "anchor": "2.1-detuning"
    }
   ]
  },
  {
   "id": "rotating-frame",
   "kind": "definition",
   "section": "2.1",
   "name": "转动参考系",
   "symbol": "c_tilde_2",
   "terms": [
    "转动参考系",
    "缓变振幅"
   ],
   "type": "amplitude",
   "statement": "定义缓变振幅，消去运动方程中光频处的快速相位演化和显含时间的项。",
   "forms": [
    {
     "id": "eq-2-5",
     "latex": "c_2(t) = \\tilde{c}_2(t)e^{-i\\nu t}",
     "anchor": "2.1-eq-2-5"
    },
    {
     "id": "eq-2-6",
     "latex": "i\\hbar\\dot{\\tilde{c}}_2(t) = -\\hbar\\delta\\tilde{c}_2(t) - \\left(\\mathcal{E} + \\mathcal{E}^* e^{2i\\nu t}\\right)\\mu c_1(t)",
     "anchor": "2.1-drv-rotating-frame-equations"
    },
    {
     "id": "eq-2-7",
     "latex": "i\\hbar\\dot{c}_1(t) = -\\left(\\mathcal{E}e^{-2i\\nu t} + \\mathcal{E}^*\\right)\\mu^*\\tilde{c}_2(t)",
     "anchor": "2.1-drv-rotating-frame-equations"
    }
   ]
  },
  {
   "id": "rabi-frequency",
   "kind": "definition",
   "section": "2.1",
   "name": "拉比频率",
   "symbol": "Omega",
   "terms": [
    "拉比频率"
   ],
   "type": "coupling",
   "statement": "被驱动原子的动力学发生的频率，等于场包络乘以偶极矩阵元再除以 ħ。",
   "forms": [
    {
     "id": "eq-2-8",
     "latex": "\\Omega = \\mathcal{E}\\mu/\\hbar",
     "anchor": "2.1-eq-2-8"
    }
   ]
  },
  {
   "id": "rotating-wave-approximation",
   "kind": "result",
   "section": "2.1",
   "name": "旋转波近似",
   "terms": [
    "旋转波近似",
    "旋转波近似"
   ],
   "statement": "当场近共振且较弱时，以两倍光频振荡的项平均而言几乎没有影响，被略去，留下不显含时间的缓变振幅方程。",
   "forms": [
    {
     "id": "eq-2-9",
     "latex": "\\text{(a) } \\delta \\ll \\nu, \\omega \\qquad \\text{(b) } \\Omega \\ll \\nu",
     "anchor": "2.1-eq-2-9"
    },
    {
     "id": "eq-2-10",
     "latex": "\\dot{\\tilde{c}}_2(t) = i\\delta\\tilde{c}_2(t) + i\\Omega c_1(t)",
     "anchor": "2.1-drv-rwa-equations"
    },
    {
     "id": "eq-2-11",
     "latex": "\\dot{c}_1(t) = i\\Omega^*\\tilde{c}_2(t)",
     "anchor": "2.1-drv-rwa-equations"
    }
   ]
  },
  {
   "id": "rabi-oscillations",
   "kind": "result",
   "section": "2.1",
   "name": "拉比振荡",
   "terms": [
    "拉比振荡"
   ],
   "statement": "在共振时，概率幅按正弦和余弦演化，两个能级的布居以拉比频率反相振荡，即辐射的周期性吸收和受激发射。",
   "forms": [
    {
     "id": "eq-2-13",
     "latex": "c_1(t) = \\cos|\\Omega|t",
     "anchor": "2.1-drv-rabi-oscillations"
    },
    {
     "id": "eq-2-14",
     "latex": "\\tilde{c}_2(t) = i\\frac{\\Omega}{|\\Omega|}\\sin|\\Omega|t",
     "anchor": "2.1-drv-rabi-oscillations"
    },
    {
     "id": "eq-2-12",
     "latex": "\\ddot{c}_1(t) = -|\\Omega|^2 c_1(t), \\quad \\ddot{\\tilde{c}}_2(t) = -|\\Omega|^2\\tilde{c}_2(t)",
     "anchor": "2.1-drv-rabi-oscillations"
    }
   ]
  },
  {
   "id": "atomic-polarization",
   "kind": "result",
   "section": "2.1",
   "name": "原子极化",
   "terms": [
    "极化"
   ],
   "type": "dipole",
   "statement": "原子的瞬时极化是偶极矩算符的期望值，它既随快速的光学时标变化，也随较慢的布居时标变化。",
   "forms": [
    {
     "id": "eq-2-15",
     "latex": "\\langle\\hat{d}\\rangle = c_1(t)^* c_2(t)\\mu^* + c_1(t)c_2(t)^*\\mu",
     "anchor": "2.1-eq-2-15"
    }
   ]
  },
  {
   "id": "pulse-area",
   "kind": "result",
   "section": "2.1",
   "name": "脉冲面积",
   "terms": [
    "外加场下的面积"
   ],
   "type": "phase",
   "statement": "当外加场振幅随时间变化而无啁啾时，概率幅只依赖于外加场下的总面积。",
   "forms": [
    {
     "id": "eq-2-18",
     "latex": "c_1(t) = \\cos\\left(\\int|\\Omega|dt\\right)",
     "anchor": "2.1-drv-pulse-area"
    },
    {
     "id": "eq-2-19",
     "latex": "\\tilde{c}_2(t) = i\\frac{\\Omega}{|\\Omega|}\\sin\\left(\\int|\\Omega|dt\\right)",
     "anchor": "2.1-drv-pulse-area"
    }
   ]
  },
  {
   "id": "adiabatic-elimination",
   "kind": "skill",
   "section": "2.1",
   "name": "绝热消除",
   "terms": [
    "绝热消除",
    "绝热跟随",
    "绝热展开"
   ],
   "statement": "对于远失谐的场，激发态概率幅中快速振荡的部分平均为零，于是令其导数为零，激发态概率幅便绝热跟随基态概率幅。",
   "forms": [
    {
     "id": "eq-2-adiabatic",
     "latex": "\\tilde{c}_2 = -(\\Omega/\\delta)c_1",
     "anchor": "2.1-adiabatic-follow"
    },
    {
     "id": "eq-2-21",
     "latex": "\\tilde{c}_2(t) = -\\frac{\\Omega}{\\delta}\\left(1 - e^{i\\delta t}\\right)",
     "anchor": "2.1-drv-far-detuned-excitation"
    }
   ]
  },
  {
   "id": "ac-stark-shift",
   "kind": "result",
   "section": "2.1",
   "name": "交流斯塔克偏移",
   "terms": [
    "交流斯塔克偏移",
    "光致频移"
   ],
   "type": "frequency",
   "statement": "远非共振的场使下态的能量移动 |Ω|²/δ。",
   "forms": [
    {
     "id": "eq-2-22",
     "latex": "c_1(t) \\approx c_1(0)e^{-i|\\Omega|^2 t/\\delta}",
     "anchor": "2.1-drv-ac-stark-shift"
    }
   ]
  },
  {
   "id": "rotating-frame-hamiltonian",
   "kind": "definition",
   "section": "2.1",
   "name": "转动参考系中的有效哈密顿量",
   "symbol": "H_tilde",
   "type": "energy",
   "statement": "原始哈密顿量在作旋转波近似后写在转动参考系中，不显含时间。",
   "forms": [
    {
     "id": "eq-2-23",
     "latex": "\\tilde{H} = -\\hbar\\delta|\\tilde{2}\\rangle\\langle\\tilde{2}| - \\hbar(\\Omega|\\tilde{2}\\rangle\\langle 1| + \\Omega^*|1\\rangle\\langle\\tilde{2}|)",
     "anchor": "2.1-eq-2-23"
    }
   ]
  },
  {
   "id": "bare-states",
   "kind": "definition",
   "section": "2.1",
   "name": "裸态",
   "terms": [
    "裸态",
    "裸原子态"
   ],
   "type": "state",
   "statement": "不存在外加场时系统的本征态。"
  },
  {
   "id": "dressed-states",
   "kind": "result",
   "section": "2.1",
   "name": "缀饰态",
   "terms": [
    "缀饰态",
    "缀饰"
   ],
   "type": "state",
   "statement": "转动参考系哈密顿量的本征矢量是裸原子态的混合；共振时它们是裸原子态的对称与反对称组合，远非共振时则与裸态相似，只混入少量另一个态。",
   "forms": [
    {
     "id": "eq-2-25",
     "latex": "|-\\rangle = |1\\rangle - \\frac{\\Omega}{\\delta}|\\tilde{2}\\rangle",
     "anchor": "2.1-eq-2-25"
    },
    {
     "id": "eq-2-26",
     "latex": "|+\\rangle = |\\tilde{2}\\rangle + \\frac{\\Omega^*}{\\delta}|1\\rangle",
     "anchor": "2.1-eq-2-26"
    }
   ]
  },
  {
   "id": "dressed-state-energies",
   "kind": "result",
   "section": "2.1",
   "name": "缀饰态能量",
   "symbol": "epsilon_pm",
   "type": "energy",
   "statement": "缀饰态的本征能量，共振时相隔两倍拉比频率，远非共振时接近裸能量。",
   "forms": [
    {
     "id": "eq-2-24",
     "latex": "\\epsilon_\\pm = \\hbar\\left(-\\frac{\\delta}{2} \\mp \\sqrt{(\\frac{\\delta}{2})^2 + |\\Omega|^2}\\right)",
     "anchor": "2.1-eq-2-24"
    }
   ]
  },
  {
   "id": "bloch-sphere",
   "kind": "definition",
   "section": "2.1",
   "name": "布洛赫球",
   "symbol": "S_tilde",
   "terms": [
    "布洛赫球",
    "布洛赫绘景"
   ],
   "type": "state",
   "statement": "二能级系统的态可以表示为单位球面上的矢量，|2⟩ 沿 +ẑ，|1⟩ 沿 −ẑ，二能级系统的自旋算符为其分量。",
   "forms": [
    {
     "id": "eq-2-27",
     "latex": "\\hat{S}_z = |2\\rangle\\langle 2| - |1\\rangle\\langle 1|",
     "anchor": "2.1-eq-2-27"
    },
    {
     "id": "eq-2-28",
     "latex": "\\hat{S}_x = |1\\rangle\\langle 2| + |2\\rangle\\langle 1|",
     "anchor": "2.1-eq-2-28"
    },
    {
     "id": "eq-2-29",
     "latex": "\\hat{S}_y = -i|2\\rangle\\langle 1| + i|1\\rangle\\langle 2|",
     "anchor": "2.1-eq-2-29"
    }
   ]
  },
  {
   "id": "bloch-precession",
   "kind": "result",
   "section": "2.1",
   "name": "布洛赫球上的进动",
   "statement": "哈密顿量起有效磁场的作用，布洛赫矢量绕由场和失谐构成的驱动矢量进动。",
   "forms": [
    {
     "id": "eq-2-33",
     "latex": "\\frac{d}{dt}\\tilde{\\mathbf{S}} = \\boldsymbol{\\Omega}(t) \\times \\tilde{\\mathbf{S}}",
     "anchor": "2.1-eq-2-33"
    },
    {
     "id": "eq-2-32",
     "latex": "\\hat{H} = -\\frac{\\hbar\\delta}{2}\\left(\\hat{S}_z + 1\\right) - \\hbar\\left(\\mathrm{Re}\\,\\Omega\\right)\\hat{\\tilde{S}}_x - \\hbar\\left(\\mathrm{Im}\\,\\Omega^*\\right)\\hat{\\tilde{S}}_y",
     "anchor": "2.1-eq-2-32"
    }
   ]
  },
  {
   "id": "multilevel-rotating-frame",
   "kind": "result",
   "section": "2.1",
   "name": "多态系统的转动参考系",
   "statement": "一个含时幺正变换使每个原子态以其对应的光频转动，只要没有任何原子跃迁与多于一个外加场相连，就得到不含时的哈密顿量。",
   "forms": [
    {
     "id": "eq-2-38",
     "latex": "\\tilde{H} = \\hat{U}^{-1}\\hat{H}\\hat{U} - i\\hbar\\hat{U}^{-1}\\frac{dU}{dt}",
     "anchor": "2.1-drv-multilevel-rotating-frame"
    },
    {
     "id": "eq-2-35",
     "latex": "\\hat{U} = e^{-i\\sum_k \\nu_k t|k\\rangle\\langle k|}",
     "anchor": "2.1-eq-2-35"
    },
    {
     "id": "eq-2-39",
     "latex": "\\tilde{H} = \\sum_k \\hbar(\\omega_k - \\nu_k)|\\tilde{k}\\rangle\\langle\\tilde{k}| - \\hbar\\sum_k\\left(\\Omega_k|\\tilde{k}\\rangle\\langle\\tilde{1}| + \\Omega_k^*|\\tilde{1}\\rangle\\langle\\tilde{k}|\\right)",
     "anchor": "2.1-drv-multilevel-rotating-frame"
    }
   ]
  },
  {
   "id": "floquet-basis",
   "kind": "definition",
   "section": "2.1",
   "name": "弗洛凯基",
   "terms": [
    "弗洛凯基",
    "拍频"
   ],
   "statement": "当两个场与同一个跃迁近共振时，概率幅按拍频展开为傅里叶级数，其各分量全部耦合。",
   "forms": [
    {
     "id": "eq-2-floquet",
     "latex": "c_i = \\sum_n c_i^{(n)}e^{in\\Delta t}",
     "anchor": "2.1-floquet"
    }
   ]
  },
  {
   "id": "bound-continuum-transition",
   "kind": "definition",
   "section": "2.2",
   "name": "束缚态到连续谱的跃迁",
   "terms": [
    "束缚态到连续谱的跃迁",
    "连续谱"
   ],
   "statement": "从束缚态到非束缚态的连续谱的跃迁，处理方法是在尺寸趋于无穷大的盒子中把连续谱离散化。",
   "forms": [
    {
     "id": "eq-2-42",
     "latex": "\\hat{H} = \\sum_k \\hbar\\left(\\omega_k - \\nu\\right)|k\\rangle\\langle k| - \\hbar\\sum_k \\left(\\Omega_k|k\\rangle\\langle 1| + \\Omega_k^*|1\\rangle\\langle k|\\right)",
     "anchor": "2.2-eq-2-42"
    },
    {
     "id": "eq-2-44",
     "latex": "\\dot{c}_1 = i\\sum_k \\Omega_k^* c_k",
     "anchor": "2.2-drv-continuum-decay"
    },
    {
     "id": "eq-2-45",
     "latex": "\\dot{c}_k = i\\delta_k c_k + i\\Omega_k c_1",
     "anchor": "2.2-drv-continuum-decay"
    }
   ]
  },
  {
   "id": "memoryless-continuum",
   "kind": "idea",
   "section": "2.2",
   "name": "无记忆的连续谱",
   "terms": [
    "记忆"
   ],
   "statement": "对密集分布的连续谱求和后，除 t = t′ 外各指数项相互抵消，所以连续谱对束缚态的作用在时间上是局域的，对先前的构型没有记忆。",
   "forms": [
    {
     "id": "eq-2-47",
     "latex": "\\dot{c}_1(t) = -\\sum_k |\\Omega_k|^2\\int_0^t c_1(t')e^{-i\\delta_k(t'-t)}dt'",
     "anchor": "2.2-drv-continuum-decay"
    }
   ]
  },
  {
   "id": "principal-value-identity",
   "kind": "result",
   "section": "2.2",
   "name": "主值恒等式",
   "statement": "复分析中的一个恒等式把该极限分解为一个 δ 函数和一个主值。",
   "forms": [
    {
     "id": "eq-2-49",
     "latex": "\\mathop{\\mathrm{lim}}\\limits_{\\epsilon\\to 0}\\frac{i}{\\delta_k + i\\epsilon} = \\pi\\delta(\\delta_k) + i\\mathcal{P}\\frac{1}{\\delta_k}",
     "anchor": "2.2-eq-2-49"
    }
   ]
  },
  {
   "id": "continuum-decay-rate",
   "kind": "result",
   "section": "2.2",
   "name": "向连续谱的衰变",
   "symbol": "gamma",
   "terms": [
    "布居衰变",
    "衰变率"
   ],
   "type": "rate",
   "statement": "与连续谱的耦合使束缚态布居以速率 γ 指数衰变，这恰是费米黄金规则给出的速率。",
   "forms": [
    {
     "id": "eq-2-51",
     "latex": "\\gamma = 2\\pi\\sum_k |\\Omega_k|^2\\delta(\\nu - \\omega_k)",
     "anchor": "2.2-eq-2-51"
    },
    {
     "id": "eq-2-50",
     "latex": "\\dot{c}_1 = -c_1(\\underbrace{\\pi\\sum_k |\\Omega_k|^2\\delta(\\nu - \\omega_k)}_{\\gamma/2} - i\\underbrace{\\sum_k |\\Omega_k|^2\\mathcal{P}\\frac{1}{\\nu - \\omega_k}}_{\\Delta_{Stark}})",
     "anchor": "2.2-drv-continuum-decay"
    },
    {
     "id": "eq-2-decay",
     "latex": "p_1(t) = p_1(0)e^{-\\gamma t}",
     "anchor": "2.2-decay-law"
    }
   ]
  },
  {
   "id": "fermi-golden-rule",
   "kind": "result",
   "section": "2.2",
   "name": "费米黄金规则",
   "terms": [
    "费米黄金规则"
   ],
   "statement": "一阶微扰论给出向连续谱的跃迁率，长时间处理再现了这一结果，因为连续谱没有记忆。"
  },
  {
   "id": "continuum-stark-shift",
   "kind": "result",
   "section": "2.2",
   "name": "来自连续谱的交流斯塔克偏移",
   "symbol": "Delta_Stark",
   "terms": [
    "交流斯塔克效应"
   ],
   "type": "frequency",
   "statement": "连续谱态也使束缚态能量移动，这在低于阈值的照射时最为重要，此时衰变消失。",
   "forms": [
    {
     "id": "eq-2-52",
     "latex": "\\Delta_{Stark} = \\sum_k |\\Omega_k|^2\\mathcal{P}\\frac{1}{\\nu - \\omega_k}",
     "anchor": "2.2-eq-2-52"
    }
   ]
  },
  {
   "id": "outgoing-wavepacket",
   "kind": "result",
   "section": "2.2",
   "name": "出射波包",
   "terms": [
    "波包"
   ],
   "statement": "长时间后，系统处于连续谱态的叠加，形成从原子向外传播的出射波包，这种行为看似不可逆，却来自幺正演化。",
   "forms": [
    {
     "id": "eq-2-54",
     "latex": "c_k(t) = i\\frac{\\Omega_k}{\\gamma/2 + i\\delta_k}(1 - e^{-(\\gamma/2 + i\\delta_k)t})e^{i\\delta_k t}",
     "anchor": "2.2-drv-continuum-amplitudes"
    }
   ]
  },
  {
   "id": "spontaneous-emission",
   "kind": "idea",
   "section": "2.3",
   "name": "自发发射",
   "terms": [
    "自发发射",
    "自发发射"
   ],
   "statement": "真实原子即使没有外加场也会从激发态衰变，这是通过它们与场的真空模的相互作用实现的，需要对电磁场作量子力学处理。"
  },
  {
   "id": "cavity-modes",
   "kind": "definition",
   "section": "2.3",
   "name": "周期共振腔的模",
   "terms": [
    "本征模",
    "行波",
    "模"
   ],
   "statement": "具有周期边界条件的大腔中的场有行波本征模，带有允许的波矢量，每个波矢量对应两个偏振。",
   "forms": [
    {
     "id": "eq-2-57",
     "latex": "k_{\\alpha,j}L_\\alpha = 2\\pi j_\\alpha",
     "anchor": "2.3-eq-2-57"
    }
   ]
  },
  {
   "id": "field-mode-expansion",
   "kind": "result",
   "section": "2.3",
   "name": "场的模展开",
   "statement": "任意激发都可以按空间模展开，每个模带有含时的坐标，归一化为谐振子的位置。",
   "forms": [
    {
     "id": "eq-2-58",
     "latex": "E_x(z,t) = \\sum_j \\sqrt{\\frac{\\nu_j^2}{\\epsilon_0 V}}\\, q_j(t)e^{ik_jz}",
     "anchor": "2.3-eq-2-58"
    },
    {
     "id": "eq-2-60",
     "latex": "E_x(z,t) = \\sum_j \\sqrt{\\frac{2\\nu_j^2}{\\epsilon_0 V}}\\, q_j\\sin k_jz",
     "anchor": "2.3-eq-2-60"
    }
   ]
  },
  {
   "id": "field-quadratures",
   "kind": "definition",
   "section": "2.3",
   "name": "模的位置与动量",
   "symbol": "q_j",
   "type": "quadrature",
   "statement": "量子化把每个模的坐标及其时间导数等同于不对易的位置和动量算符，如同单位质量的谐振子。",
   "forms": [
    {
     "id": "eq-2-65",
     "latex": "[\\hat{q}_j, \\hat{p}_{j'}] = i\\hbar\\delta_{j,j'}",
     "anchor": "2.3-eq-2-65"
    },
    {
     "id": "eq-2-64",
     "latex": "q_j \\to \\hat{q}_j \\quad \\dot{q}_j \\to \\hat{p}_j",
     "anchor": "2.3-eq-2-64"
    }
   ]
  },
  {
   "id": "creation-annihilation-operators",
   "kind": "definition",
   "section": "2.3",
   "name": "产生算符与湮没算符",
   "terms": [
    "产生算符和湮没算符",
    "湮没算符"
   ],
   "statement": "产生和湮没每个模和偏振的激发的算符。",
   "forms": [
    {
     "id": "eq-2-66",
     "latex": "\\hat{a}_j = \\frac{1}{\\sqrt{2\\hbar\\nu_j}}\\left(\\nu_j\\hat{q}_j + i\\hat{p}_j\\right)",
     "anchor": "2.3-eq-2-66"
    },
    {
     "id": "eq-2-67",
     "latex": "\\hat{a}_j^\\dagger = \\frac{1}{\\sqrt{2\\hbar\\nu_j}}\\left(\\nu_j\\hat{q}_j - i\\hat{p}_j\\right)",
     "anchor": "2.3-eq-2-67"
    }
   ]
  },
  {
   "id": "field-hamiltonian",
   "kind": "result",
   "section": "2.3",
   "name": "量子化场的哈密顿量",
   "type": "energy",
   "statement": "腔内的经典能量是一组谐振子的能量，每个模一个，每个激发的能量为 ħν_j，真空能量为其一半。",
   "forms": [
    {
     "id": "eq-2-69",
     "latex": "\\hat{H} = \\sum_j \\hbar\\nu_j\\left(\\hat{a}_j^\\dagger\\hat{a}_j + \\frac{1}{2}\\right)",
     "anchor": "2.3-drv-field-hamiltonian-ladder"
    },
    {
     "id": "eq-2-62",
     "latex": "H = \\frac{1}{2}\\int dV\\left(\\epsilon_0E^2 + \\frac{1}{\\mu_0}B^2\\right)",
     "anchor": "2.3-eq-2-62"
    },
    {
     "id": "eq-2-68",
     "latex": "\\hat{H} = \\frac{1}{2}\\sum_j\\left(\\nu_j^2\\hat{q}_j^2 + \\hat{p}_j^2\\right)",
     "anchor": "2.3-drv-field-hamiltonian-ladder"
    }
   ]
  },
  {
   "id": "quantized-electric-field",
   "kind": "result",
   "section": "2.3",
   "name": "量子化电场",
   "terms": [
