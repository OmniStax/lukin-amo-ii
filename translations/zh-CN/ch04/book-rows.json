 "concepts": [
  {
   "id": "macroscopic-polarization",
   "kind": "definition",
   "section": "4.1",
   "name": "宏观极化",
   "terms": [
    "宏观极化"
   ],
   "symbol": "P_pol",
   "type": "dipole",
   "statement": "原子系综的极化强度是小体积内原子的单位体积偶极矩，每个原子的贡献为 ⟨d̂⟩ = μρ₂₁ + μ*ρ₁₂；它像场一样随空间变化。",
   "forms": [
    {
     "id": "eq-4-4",
     "latex": "P(r_i) = \\frac{N_i}{V_i}\\sum_{r_j \\in V_i}\\left(\\mu\\rho_{21}(r_j) + \\mu^*\\rho_{12}(r_j)\\right)"
    },
    {
     "id": "eq-4-1",
     "latex": "\\langle\\hat{d}\\rangle = \\mu\\rho_{21} + \\mu^*\\rho_{12}"
    },
    {
     "id": "eq-4-2",
     "latex": "P = \\frac{N}{V}\\left(\\mu\\rho_{21} + \\mu^*\\rho_{12}\\right)"
    }
   ]
  },
  {
   "id": "independent-atoms",
   "kind": "idea",
   "section": "4.1",
   "name": "独立原子",
   "statement": "当原子不发生强相互作用、每个原子被各自的热库阻尼（|r_i − r_j| > λ）、且外加场是经典的时，系综可以用单原子光学布洛赫方程逐个原子处理；系综密度矩阵此时因子化为单原子密度矩阵的乘积。",
   "forms": [
    {
     "id": "eq-4-3",
     "latex": "\\hat{\\rho}_{ensemble} = \\prod_{j=1}^{N}\\hat{\\rho}^{(1)} \\otimes \\ldots \\otimes \\hat{\\rho}^{(N)}"
    }
   ]
  },
  {
   "id": "maxwell-equations-with-polarization",
   "kind": "result",
   "section": "4.1",
   "name": "含极化源的麦克斯韦方程组",
   "statement": "自洽性要求场所诱导的极化强度反过来作为支配光的麦克斯韦方程组中的源项起作用。",
   "forms": [
    {
     "id": "eq-4-5",
     "latex": "\\nabla \\times \\mathbf{E} = -\\frac{\\partial\\mathbf{B}}{\\partial t}"
    },
    {
     "id": "eq-4-6",
     "latex": "\\nabla \\times \\mathbf{B} = \\frac{1}{c^2}\\frac{\\partial}{\\partial t}\\left(\\mathbf{E} + \\frac{1}{\\epsilon_0}\\mathbf{P}\\right)"
    }
   ]
  },
  {
   "id": "wave-equation-with-polarization",
   "kind": "result",
   "section": "4.1",
   "name": "含极化源的波动方程",
   "statement": "没有非束缚电荷和电流时，麦克斯韦方程组化为关于 E 的波动方程，由极化强度对时间的二阶导数驱动。",
   "forms": [
    {
     "id": "eq-4-10",
     "latex": "\\nabla^2\\mathbf{E} - \\frac{1}{c^2}\\frac{\\partial^2\\mathbf{E}}{\\partial t^2} = \\frac{1}{\\epsilon_0 c^2}\\frac{\\partial^2\\mathbf{P}}{\\partial t^2}",
     "anchor": "4.1-drv-wave-equation"
    }
   ]
  },
  {
   "id": "slowly-varying-envelope-approximation",
   "kind": "idea",
   "section": "4.1",
   "name": "缓变包络近似",
   "terms": [
    "缓变包络近似",
    "缓变包络近似",
    "SVEA"
   ],
   "statement": "近单色场及其极化强度写成载波上的包络，载波的中心频率为 ν̄，波矢量为 k̄ = ν̄/c；只保留在光学周期和波长上缓变的包络的最低阶导数，二阶波动方程便化为一阶方程。",
   "forms": [
    {
     "id": "eq-4-11",
     "latex": "\\mathbf{E}(r, t) = \\mathcal{E}(r, t)e^{i\\bar{k}z - i\\bar{\\nu}t} + c.c.",
     "anchor": "4.1-eq-4-11"
    },
    {
     "id": "eq-4-19",
     "latex": "|\\bar{\\nu}\\mathcal{P}| \\gg |\\tfrac{\\partial}{\\partial t}\\mathcal{P}|",
     "anchor": "4.1-drv-svea-propagation"
    },
    {
     "id": "eq-4-20",
     "latex": "|\\bar{\\nu}\\mathcal{E}| \\gg |\\tfrac{\\partial}{\\partial t}\\mathcal{E}|",
     "anchor": "4.1-drv-svea-propagation"
    },
    {
     "id": "eq-4-21",
     "latex": "|\\bar{k}\\mathcal{E}| \\gg |\\tfrac{\\partial}{\\partial z}\\mathcal{E}|",
     "anchor": "4.1-drv-svea-propagation"
    }
   ]
  },
  {
   "id": "slowly-varying-polarization",
   "kind": "definition",
   "section": "4.1",
   "name": "缓变极化",
   "terms": [
    "缓变极化",
    "极化强度"
   ],
   "symbol": "P_env",
   "type": "dipole",
   "statement": "缓变极化振幅 𝒫 是载波上极化强度的包络；它正比于转动参考系中偶极算符的正频分量，对二能级原子 𝒫 = (N/V)μρ₂₁(z)e^{−ik̄z}。",
   "forms": [
    {
     "id": "eq-4-12",
     "latex": "\\mathbf{P}(r, t) = \\mathcal{P}(r, t)e^{i\\bar{k}z - i\\bar{\\nu}t} + c.c.",
     "anchor": "4.1-eq-4-12"
    }
   ]
  },
  {
   "id": "svea-propagation-equation",
   "kind": "result",
   "section": "4.1",
   "name": "缓变振幅的传播方程",
   "statement": "在缓变包络近似中，包络满足一阶方程：横向衍射、以 c 传播，以及作为源的缓变极化。",
   "forms": [
    {
     "id": "eq-4-24",
     "latex": "\\frac{1}{2i\\bar{k}}\\nabla_\\perp^2\\mathcal{E} + \\frac{\\partial}{\\partial z}\\mathcal{E} + \\frac{1}{c}\\frac{\\partial}{\\partial t}\\mathcal{E} = \\frac{i\\bar{k}}{2\\epsilon_0}\\mathcal{P}",
     "anchor": "4.1-drv-svea-propagation"
    },
    {
     "id": "eq-4-13",
     "latex": "\\frac{1}{2i\\bar{k}}\\nabla_\\perp^2\\mathcal{E} + \\frac{\\partial\\mathcal{E}}{\\partial z} + \\frac{1}{c}\\frac{\\partial\\mathcal{E}}{\\partial t} = \\frac{i\\bar{k}}{2\\epsilon_0}\\mathcal{P}",
     "anchor": "4.1-drv-svea-propagation"
    }
   ]
  },
  {
   "id": "plane-wave-propagation-equation",
   "kind": "result",
   "section": "4.1",
   "name": "平面波传播方程",
   "statement": "对平面波，横向项为零，包络满足 ∂𝓔/∂z + (1/c)∂𝓔/∂t = (ik̄/2ε₀)𝒫。",
   "forms": [
    {
     "id": "eq-4-25",
     "latex": "\\frac{\\partial}{\\partial z}\\mathcal{E} + \\frac{1}{c}\\frac{\\partial}{\\partial t}\\mathcal{E} = \\frac{i\\bar{k}}{2\\epsilon_0}\\mathcal{P}",
     "anchor": "4.1-eq-4-25"
    }
   ]
  },
  {
   "id": "optical-frequency-comb",
   "kind": "definition",
   "section": "4.1",
   "name": "光频梳",
   "terms": [
    "光频梳"
   ],
   "statement": "周期性的短光脉冲序列在傅里叶域中是一个谐波梳：谐波间隔决定重复频率，所占据的带宽决定脉冲持续时间。",
   "forms": [
    {
     "id": "eq-4-26",
     "latex": "E = \\sum_n\\mathcal{E}_n(z, t)e^{inkz - i\\nu_n t}",
     "anchor": "4.1-eq-4-26"
    }
   ]
  },
  {
   "id": "multimode-svea",
   "kind": "result",
   "section": "4.1",
   "name": "多谐波 SVEA",
   "terms": [
    "耦合麦克斯韦-布洛赫方程",
    "麦克斯韦-布洛赫方程"
   ],
   "statement": "当每个谐波都有缓变包络时，传播方程对每个谐波分别成立，对任意短的脉冲也成立；原子响应使各谐波耦合，给出耦合麦克斯韦-布洛赫方程。",
   "forms": [
    {
     "id": "eq-4-28",
     "latex": "\\frac{1}{2i\\bar{k}}\\nabla_\\perp^2\\mathcal{E}_n + \\frac{\\partial}{\\partial z}\\mathcal{E}_n + \\frac{1}{c}\\frac{\\partial}{\\partial t}\\mathcal{E}_n = \\frac{i\\bar{k}}{2\\epsilon_0}\\mathcal{P}_n",
     "anchor": "4.1-eq-4-28"
    },
    {
     "id": "eq-4-27",
     "latex": "P = \\sum_n\\mathcal{P}_n(z, t)e^{inkz - i\\nu_n t}",
     "anchor": "4.1-eq-4-27"
    }
   ]
  },
  {
   "id": "susceptibility",
   "kind": "definition",
   "section": "4.2",
   "name": "电极化率",
   "terms": [
    "电极化率"
   ],
   "symbol": "chi",
   "type": "susceptibility",
   "statement": "当原子作线性响应时，极化强度正比于场，比例常数即电极化率 χ，它完整地刻画线性情形下的原子-光子相互作用。",
   "forms": [
    {
     "id": "eq-4-30",
     "latex": "\\chi(\\delta\\nu) = \\frac{\\mathcal{P}(\\delta\\nu)}{\\epsilon_0\\mathcal{E}(\\delta\\nu)}",
     "anchor": "4.2-eq-4-30"
    },
    {
     "id": "eq-4-29",
     "latex": "\\mathcal{P}(\\delta\\nu) = \\frac{N}{V}\\mu\\rho_{21}(\\delta\\nu)e^{-i\\bar{k}z}",
     "anchor": "4.2-eq-4-29"
    }
   ]
  },
  {
   "id": "linear-propagation-solution",
   "kind": "result",
   "section": "4.2",
   "name": "线性传播的一般解",
   "statement": "在线性情形下，场的每个频率分量各自传播，获得相位 z(δν/c + k̄χ(δν)/2)；变换回时域，便由场在一处的谱给出任意位置的场。",
   "forms": [
    {
     "id": "eq-4-34",
     "latex": "\\mathcal{E}(t, z) = \\int d(\\delta\\nu)e^{-i\\delta\\nu t}\\mathcal{E}(\\delta\\nu, 0)e^{iz(\\delta\\nu/c + \\bar{k}\\chi(\\delta\\nu)/2)}",
     "anchor": "4.2-drv-linear-propagation"
    },
    {
     "id": "eq-4-32",
     "latex": "\\frac{\\partial\\mathcal{E}}{\\partial z} = \\frac{i\\delta\\nu}{c}\\mathcal{E} + \\frac{i\\bar{k}}{2}\\chi(\\delta\\nu)\\mathcal{E}",
     "anchor": "4.2-drv-linear-propagation"
    },
    {
     "id": "eq-4-33",
     "latex": "\\mathcal{E}(\\delta\\nu, z) = \\mathcal{E}(\\delta\\nu, 0)e^{iz(\\delta\\nu/c + \\bar{k}\\chi(\\delta\\nu)/2)}",
     "anchor": "4.2-drv-linear-propagation"
    }
   ]
  },
  {
   "id": "absorption-coefficient",
   "kind": "definition",
   "section": "4.2",
   "name": "吸收系数",
   "terms": [
    "吸收"
   ],
   "symbol": "alpha",
   "type": "susceptibility",
   "statement": "电极化率的虚部使光束光强随距离按指数衰减或放大，速率为 α = k̄ Im[χ(0)]。",
   "forms": [
    {
     "id": "eq-4-36",
     "latex": "\\alpha = \\bar{k}\\ \\mathrm{Im}[\\chi(0)]",
     "anchor": "4.2-eq-4-36"
    }
   ]
  },
  {
   "id": "refractive-index",
   "kind": "definition",
   "section": "4.2",
   "name": "折射率",
   "terms": [
    "折射率",
    "折射"
   ],
   "symbol": "n_ref",
   "type": "susceptibility",
   "statement": "电极化率的实部使场的相位随距离线性移动，即波矢量的变化 k̄ → k̄ + k̄Re[χ]/2，或折射率的变化。",
   "forms": [
    {
     "id": "eq-4-37",
     "latex": "n = 1 + \\frac{\\mathrm{Re}[\\chi(0)]}{2}",
     "anchor": "4.2-eq-4-37"
    },
    {
     "id": "eq-4-35",
     "latex": "\\mathcal{E}(t, z) = \\mathcal{E}e^{i\\bar{k}\\chi(0)z/2}",
     "anchor": "4.2-eq-4-35"
    }
   ]
  },
  {
   "id": "dispersion",
   "kind": "idea",
   "section": "4.2",
   "name": "色散",
   "terms": [
    "色散"
   ],
   "statement": "色散源于电极化率对频率的依赖；将 χ 在共振处展开，第一项给出折射，第二项给出群速度，第三项给出群速度色散。",
   "forms": [
    {
     "id": "eq-4-38",
     "latex": "\\chi(\\delta\\nu) \\approx \\chi(0) + \\frac{d\\chi}{d\\nu}\\delta\\nu + \\ldots",
     "anchor": "4.2-eq-4-38"
    }
   ]
  },
  {
   "id": "group-velocity",
   "kind": "definition",
   "section": "4.2",
   "name": "群速度",
   "terms": [
    "群速度"
   ],
   "symbol": "v_g",
   "type": "velocity",
   "statement": "保留电极化率的斜率时，包络以群速度 v_g 传播，形状不变。",
   "forms": [
    {
     "id": "eq-4-42",
     "latex": "v_g = \\frac{c}{1 + \\frac{\\bar{\\nu}}{2}\\frac{d\\chi}{d\\nu}}",
     "anchor": "4.2-drv-group-velocity"
    },
    {
     "id": "eq-4-41",
     "latex": "\\mathcal{E}(t, z) = e^{iz\\bar{k}\\chi(0)/2}\\mathcal{E}(t - z/v_g, z = 0)",
     "anchor": "4.2-drv-group-velocity"
    }
   ]
  },
  {
   "id": "two-level-susceptibility",
   "kind": "result",
   "section": "4.2",
   "name": "二能级原子的电极化率",
   "statement": "对处于定常态的二能级原子稀薄气体，电极化率是谱线宽度为 γ₁₂ 的洛伦兹线型，正比于密度、λ³ 和布居差。",
   "forms": [
    {
     "id": "eq-4-44",
     "latex": "\\chi(\\delta\\nu) = i\\frac{3}{8\\pi^2}\\frac{N}{V}\\lambda^3\\left(\\rho_{11}^0 - \\rho_{22}^0\\right)\\frac{\\gamma}{\\gamma_{12} - i\\delta\\nu}",
     "anchor": "4.2-eq-4-44"
    },
    {
     "id": "eq-4-43",
     "latex": "\\chi(\\delta\\nu) = i\\frac{N}{V}\\frac{\\mu^2}{\\hbar\\epsilon_0}\\left(\\rho_{11}^0 - \\rho_{22}^0\\right)\\frac{1}{\\gamma_{12} - i\\delta\\nu}",
     "anchor": "4.2-drv-two-level-susceptibility"
    }
   ]
  },
  {
   "id": "resonant-absorption",
   "kind": "result",
   "section": "4.2",
   "name": "共振时的吸收",
   "statement": "共振时电极化率为纯虚数：没有折射，但有吸收，场按指数衰减。",
   "forms": [
    {
     "id": "eq-4-45",
     "latex": "\\chi(0) = i\\frac{3}{8\\pi^2}\\frac{N}{V}\\lambda^3\\frac{\\gamma}{\\gamma_{12}}",
     "anchor": "4.2-drv-resonant-cross-section"
    },
    {
     "id": "eq-4-46",
     "latex": "\\mathcal{E}(z) = \\mathcal{E}(0)e^{(-\\mathrm{Im}[\\chi(0)] + i\\mathrm{Re}[\\chi(0)])\\bar{k}z/2}",
     "anchor": "4.2-drv-resonant-cross-section"
    }
   ]
  },
  {
   "id": "absorption-cross-section",
   "kind": "definition",
   "section": "4.2",
   "name": "吸收截面",
   "terms": [
    "吸收截面",
    "截面"
   ],
   "symbol": "sigma_tilde",
   "statement": "光强按 I(z) = I(0)e^{−Nσ̃z/V} 衰减，由此定义吸收截面 σ̃ = (3/4π)λ²γ/γ₁₂。",
   "forms": [
    {
     "id": "eq-4-48",
     "latex": "\\tilde{\\sigma} = \\frac{3}{4\\pi}\\lambda^2\\frac{\\gamma}{\\gamma_{12}}",
     "anchor": "4.2-drv-resonant-cross-section"
    },
    {
     "id": "eq-4-47",
     "latex": "I(z) = I(0)e^{-N\\tilde{\\sigma}z/V}",
     "anchor": "4.2-drv-resonant-cross-section"
    }
   ]
  },
  {
   "id": "unitary-limit",
   "kind": "result",
   "section": "4.2",
   "name": "幺正极限",
   "terms": [
    "幺正极限"
   ],
   "statement": "对纯辐射增宽，共振截面为 3λ²/2π，与偶极矩无关：这是最大吸收截面，即幺正极限。",
   "forms": [
    {
     "id": "eq-4-49",
     "latex": "\\tilde{\\sigma} \\to \\frac{3}{2\\pi}\\lambda^2",
     "anchor": "4.2-drv-resonant-cross-section"
    }
   ]
  },
  {
   "id": "far-detuned-refraction",
   "kind": "result",
   "section": "4.2",
   "name": "远失谐介质具有折射性",
   "statement": "远离共振时，Im[χ] ∝ 1/δν² 远小于 Re[χ] ∝ 1/δν，因此介质几乎完全是折射性的，吸收很少。"
  },
  {
   "id": "homogeneous-broadening",
   "kind": "definition",
   "section": "4.2",
   "name": "均匀谱线增宽",
   "terms": [
    "均匀"
   ],
   "statement": "均匀谱线宽度来自对每个原子产生相同影响的过程。"
  },
  {
   "id": "inhomogeneous-broadening",
   "kind": "definition",
   "section": "4.2",
   "name": "非均匀谱线增宽",
   "terms": [
    "非均匀",
    "非均匀谱线增宽"
   ],
   "statement": "非均匀谱线增宽使系综的谱线变宽，却不使其组成原子的谱线变宽，这些原子看到不同的跃迁频率（固体中的局域场，热气体中的多普勒频移）；它可以掩盖均匀谱线宽度。"
  },
  {
   "id": "doppler-broadening",
   "kind": "result",
   "section": "4.2",
   "name": "多普勒谱线增宽",
   "terms": [
    "多普勒谱线增宽",
    "多普勒谱线增宽的"
   ],
   "statement": "速度为 v_z 的原子看到的场频率移为 ν − kv_z，因此热气体对每个频率的吸收都经由一个速度类；对速度类求和，当 γ₁₂ ≫ kv_T 时得到洛伦兹谱，在相反极限下得到宽度约为 kv_T 的高斯谱，它随温度的平方根增长。",
   "forms": [
    {
     "id": "eq-4-50",
     "latex": "\\chi(\\delta\\nu) \\approx \\int dv_z\\frac{n(v_z)}{\\gamma_{12} - i(\\delta\\nu - kv_z)}",
     "anchor": "4.2-eq-4-50"
    },
    {
     "id": "eq-4-51",
     "latex": "n(v_z) = \\frac{N}{V}e^{-v_z^2/v_T^2}\\frac{1}{\\sqrt{\\pi}v_T}",
     "anchor": "4.2-eq-4-51"
    }
   ]
  },
  {
   "id": "inhomogeneous-cross-section",
   "kind": "result",
   "section": "4.2",
   "name": "多普勒谱线增宽气体的截面",
   "statement": "非均匀谱线增宽使共振截面减小约 γ₁₂/kv_T。",
   "forms": [
    {
     "id": "eq-4-52",
     "latex": "\\sigma_{inhom.}(0) = \\frac{3}{4\\pi}\\lambda^2\\frac{\\sqrt{\\pi}\\gamma}{kv_T}",
     "anchor": "4.2-drv-doppler-cross-section"
    }
   ]
  },
  {
   "id": "nonlinear-susceptibility",
   "kind": "definition",
   "section": "4.3",
   "name": "非线性电极化率",
   "terms": [
    "非线性电极化率"
   ],
   "symbol": "chi_n",
   "type": "susceptibility",
   "statement": "对定常态下的强连续波场，饱和的布居差 γ/(γ + 2R_opt) 乘以线性电极化率；χ_n 只适用于连续波定常态。",
   "forms": [
    {
     "id": "eq-4-58",
     "latex": "\\chi_n(\\delta) = \\frac{3}{8\\pi^2}\\frac{N}{V}\\lambda^3\\frac{i\\gamma}{\\gamma_{12} - i\\delta}\\frac{\\gamma}{\\gamma + 2R_{opt}}",
     "anchor": "4.3-drv-nonlinear-susceptibility"
    },
    {
     "id": "eq-4-56",
     "latex": "\\chi_n(\\delta) = \\frac{\\mathcal{P}(\\delta)}{\\epsilon_0\\mathcal{E}(\\delta)}",
     "anchor": "4.3-drv-nonlinear-susceptibility"
    },
    {
     "id": "eq-4-54",
     "latex": "\\rho_{11} - \\rho_{22} = \\frac{\\gamma}{\\gamma + 2R_{opt}}",
     "anchor": "4.3-eq-4-54"
    }
   ]
  },
  {
   "id": "nonlinear-propagation",
   "kind": "result",
   "section": "4.3",
   "name": "连续波场的非线性传播",
   "terms": [
    "饱和吸收"
   ],
   "statement": "对连续波场，时间导数略去，∂𝓔/∂z 由 χ_n 确定，χ_n 通过 R_opt 依赖于场：场增强时，吸收减弱。",
   "forms": [
    {
     "id": "eq-4-59",
     "latex": "\\frac{\\partial\\mathcal{E}}{\\partial z} = i\\bar{k}\\chi_n(\\delta)\\mathcal{E}",
     "anchor": "4.3-drv-nonlinear-propagation"
    }
   ]
  },
  {
   "id": "saturation-parameter",
   "kind": "definition",
   "section": "4.3",
   "name": "饱和参量",
   "terms": [
    "饱和参量"
   ],
   "symbol": "s_sat",
   "statement": "饱和参量 s = 2R_opt/γ，共振时为 4|Ω|²/γ₁₂γ，它把光抽运率与衰变相比较；当 s ≫ 1 时，场漂白介质。",
   "forms": [
    {
     "id": "eq-4-63",
     "latex": "s = \\frac{2R_{opt}}{\\gamma}",
     "anchor": "4.3-eq-4-63"
    },
    {
     "id": "eq-4-62",
     "latex": "s = \\frac{4|\\Omega|^2}{\\gamma_{12}\\gamma}",
     "anchor": "4.3-eq-4-62"
    }
   ]
  },
  {
   "id": "resonant-saturation",
   "kind": "result",
   "section": "4.3",
   "name": "共振时的饱和",
   "terms": [
    "漂白"
   ],
   "statement": "共振时 Im[χ_n] 按 1/(1+s) 下降；接近饱和光强的场先随距离线性衰减，然后一旦变弱便按指数衰减。",
   "forms": [
    {
     "id": "eq-4-61",
     "latex": "\\mathrm{Im}[\\chi_n(0)] = \\frac{3}{8\\pi^2}\\frac{N}{V}\\lambda^3\\frac{\\gamma}{\\gamma_{12}}\\frac{1}{1 + s}",
     "anchor": "4.3-eq-4-61"
    }
   ]
  },
  {
   "id": "kerr-effect",
   "kind": "definition",
   "section": "4.3",
   "name": "克尔效应",
   "terms": [
    "克尔效应",
    "自调相",
    "自聚焦"
   ],
   "statement": "远离共振时，折射率依赖于光强，n = n₀ + n₂I，这给出自调相，以及有限光束的自聚焦或自散焦。",
   "forms": [
    {
     "id": "eq-4-64",
     "latex": "\\chi_n \\approx -\\frac{3}{8\\pi^2}\\frac{N}{V}\\lambda^3\\frac{\\gamma}{\\delta}\\left(1 - \\frac{4|\\Omega|^2\\gamma_{12}}{\\delta^2\\gamma}\\right)",
     "anchor": "4.3-drv-far-detuned-susceptibility"
    }
   ]
  },
  {
   "id": "third-order-susceptibility",
   "kind": "definition",
   "section": "4.3",
   "name": "三阶电极化率",
   "symbol": "chi_3",
   "type": "susceptibility",
   "statement": "对弱场，电极化率展开为 χ + χ⁽³⁾|E|² + …，χ⁽³⁾ 是具有反演对称性的系统中领头阶非线性修正。",
   "forms": [
    {
     "id": "eq-4-65",
     "latex": "\\chi_n = \\chi + \\chi^{(3)}|E|^2 + \\ldots",
     "anchor": "4.3-eq-4-65"
    },
    {
     "id": "eq-5-82",
     "latex": "\\chi^{(3)} = \\frac{P}{\\epsilon_0\\mathcal{E}_1\\mathcal{E}_2\\mathcal{E}_3}",
     "anchor": "5.3-eq-5-82",
     "section": "5.3"
    }
   ]
  },
  {
   "id": "saturation-intensity",
   "kind": "result",
   "section": "4.3",
   "name": "饱和光强",
   "type": "intensity",
   "statement": "辐射增宽的跃迁在共振处于 8|Ω|² ≈ γ² 时饱和，对碱金属原子，光强为几 mW/cm²；在多普勒谱线增宽的气体中，该场只使一个速度类饱和。"
  },
  {
   "id": "optical-pumping",
   "kind": "idea",
   "section": "4.3",
   "name": "光抽运",
   "terms": [
    "光抽运"
   ],
   "statement": "有另一个长寿命能级时，激发态原子可以衰变到受驱跃迁之外，于是布居最终落在该能级上，饱和只需要 R_opt 超过该慢衰变。"
  },
  {
   "id": "saturation-spectroscopy",
   "kind": "idea",
   "section": "4.3",
   "name": "饱和光谱学",
   "terms": [
    "饱和光谱学",
    "饱和光谱学"
   ],
   "statement": "同一频率的两束对传光束，一束强抽运光和一束弱探测光，作用于速度类 ν = Δ ± kv_z；在共振附近二者都作用于静止的原子，探测光吸收在多普勒轮廓之内显示出具有固有线宽的尖锐特征。",
   "forms": [
    {
     "id": "eq-4-66",
     "latex": "\\mathbf{E} = \\mathcal{E}_+e^{-i\\nu t + ikz} + \\mathcal{E}_-e^{-i\\nu t - ikz} + c.c",
     "anchor": "4.3-eq-4-66"
    }
   ]
  },
  {
   "id": "saturated-absorption-dip",
   "kind": "result",
   "section": "4.3",
   "name": "饱和吸收凹陷",
   "terms": [
    "饱和吸收"
   ],
   "statement": "对抽运光取最低阶时，探测光吸收在 δ = 0 处有一个消多普勒宽度为 γ₁₂ 的凹陷。",
   "forms": [
    {
     "id": "eq-4-75",
     "latex": "\\mathrm{Im}[\\chi_-]_\\mathrm{sat} \\approx -\\frac{|\\mu|^2 n}{\\epsilon_0\\hbar k}\\frac{2\\pi|\\Omega_+|^2(\\gamma_{12}/\\gamma)}{(\\gamma_{12}^2 + \\delta^2)}",
     "anchor": "4.3-drv-saturated-absorption-dip"
    },
    {
     "id": "eq-4-74",
     "latex": "\\chi_- = \\frac{|\\mu|^2}{\\epsilon_0\\hbar}\\int dv_z n(v_z)\\frac{i}{\\gamma_{12} - i(\\delta + kv_z)}\\left(1 - \\frac{S(\\delta - kv_z)}{1 + S(\\delta - kv_z)}\\right)",
     "anchor": "4.3-drv-probe-susceptibility"
    },
    {
     "id": "eq-4-72",
     "latex": "\\rho_{21}^{(v_z)-} \\approx \\left(\\frac{\\gamma_{12}^2 + (\\delta - kv_z)^2}{\\gamma_{12}^2 + (\\delta - kv_z)^2 + 4|\\Omega_+|^2(\\gamma_{12}/\\gamma)}\\right)\\left(\\frac{i\\Omega_-}{\\gamma_{12} - i(\\delta + kv_z)}\\right)",
     "anchor": "4.3-drv-probe-coherence"
    },
    {
     "id": "eq-4-76",
     "latex": "\\int_{-\\infty}^{\\infty}\\frac{1}{1 + (x - a)^2}\\frac{1}{1 + (x + a)^2} = \\frac{\\pi}{2(1 + a^2)}",
     "anchor": "4.3-drv-saturated-absorption-dip"
    }
   ]
  }
