       "src": "(11.121)"
      }
     ],
     "then": {
      "tex": "\\mk{H}{\\kH_\\mathrm{int}} = \\mk{R}{\\frac{1}{2}\\frac{4\\pi\\hbar^2\\kas}{\\km}\\sum_{i,j,k,l}\\int\\hat{b}_i^\\dagger\\hat{b}_j^\\dagger\\hat{b}_k\\hat{b}_l\\phi^*(\\mathbf{r} - \\mathbf{r}_i)\\phi^*(\\mathbf{r} - \\mathbf{r}_j)\\phi(\\mathbf{r} - \\mathbf{r}_k)\\phi(\\mathbf{r} - \\mathbf{r}_l)d^3\\mathbf{r}}",
      "src": "11.8.1",
      "uses": []
     },
     "steps": [
      {
