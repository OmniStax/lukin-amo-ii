       "uses": [
        0
       ],
       "map": {
        "R": [
         "U",
         "b"
        ]
       }
      },
      {
       "tex": "\\mk{H}{\\kH_\\mathrm{int}} = \\frac{1}{2}\\mk{U}{\\frac{4\\pi\\hbar^2\\kas}{\\km}\\sum_i\\int|\\phi(\\mathbf{r} - \\mathbf{r}_i)|^4}\\cdot\\mk{b}{\\hat{n}_i(\\hat{n}_i - 1)}",
       "uses": [
