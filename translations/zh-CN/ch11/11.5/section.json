       ]
      },
      {
       "tex": "\\mk{w}{\\hbar\\komega_\\mathrm{min}} = \\mk{M}{\\sqrt{\\epsilon_{\\kq_\\mathrm{min}}^2 - 2\\knzero|\\kUzero|\\epsilon_{\\kq_\\mathrm{min}}}}",
       "uses": [
