      }
     ],
     "then": {
      "tex": "\\mk{Ld}{(\\kmuchem + \\hbar\\komega_j)u_j\\hat{\\alpha}_je^{-i\\komega_j \\kt} - (\\kmuchem - \\hbar\\komega_j)v_j^*\\hat{\\alpha}_j^\\dagger e^{i\\komega_j \\kt}} = \\mk{R}{\\left(-\\frac{\\hbar^2\\nabla^2}{2\\km} + \\kV(r) + 2\\kUzero\\tilde{\\kpsiGP}^2\\right)(u_j\\hat{\\alpha}_je^{-i\\komega_j \\kt} - v_j^*\\hat{\\alpha}_j^\\dagger e^{i\\komega_j \\kt})} + \\mk{U}{\\kUzero\\tilde{\\kpsiGP}^2(u_j^*\\hat{\\alpha}_j^\\dagger e^{i\\komega_j \\kt} - v_j\\hat{\\alpha}_je^{-i\\komega_j \\kt})}",
      "uses": []
