  {
   "id": "bogoliubov-spectrum",
   "what": "博戈留波夫色散关系",
   "source": "现代原子与光学物理 II，11.5 玻色凝聚体中的激发，11.5.1",
   "nodes": [
    {
     "assumes": [
      {
       "text": "负的平方根不满足归一化条件 (11.145)。",
       "src": "11.5.1"
      }
     ],
     "then": {
      "tex": "\\mk{M}{\\begin{pmatrix} \\kepsq + \\knzero\\kUzero - \\hbar\\komegaq & -\\knzero\\kUzero \\\\ -\\knzero\\kUzero & \\kepsq + \\knzero\\kUzero + \\hbar\\komegaq \\end{pmatrix}\\begin{pmatrix} u_q \\\\ v_q \\end{pmatrix}} = \\mk{z}{0}",
      "src": "(11.150)",
      "uses": []
     },
     "steps": [
      {
       "tex": "\\mk{M}{(\\kepsq + \\knzero\\kUzero - \\hbar\\komegaq)(\\kepsq + \\knzero\\kUzero + \\hbar\\komegaq) - (\\knzero\\kUzero)^2} = \\mk{z}{0}",
       "uses": [],
       "cap": "要使$(u_q, v_q) \\neq 0$的解存在，矩阵的行列式必须为零。"
      },
      {
       "tex": "\\mk{M}{(\\kepsq + \\knzero\\kUzero)^2 - (\\hbar\\komegaq)^2 - (\\knzero\\kUzero)^2} = \\mk{z}{0}",
       "uses": [],
       "cap": "平方差，$(x - y)(x + y) = x^2 - y^2$。"
      },
      {
       "tex": "\\mk{w}{(\\hbar\\komegaq)^2} = \\mk{M}{\\kepsq^2 + 2\\knzero\\kUzero\\kepsq}",
       "uses": []
      },
      {
       "tex": "\\mk{w}{\\hbar\\komegaq} = \\mk{M}{\\sqrt{\\kepsq^2 + 2\\knzero\\kUzero\\kepsq}}",
       "uses": [
        0
       ]
      }
     ],
     "num": "(11.151)"
    }
   ]
  },
  {
   "id": "landau-critical-velocity",
   "what": "朗道临界速度",
   "source": "现代原子与光学物理 II，11.5 玻色凝聚体中的激发，11.5.1",
   "nodes": [
    {
     "assumes": [
      {
       "tex": "\\Delta \\kpcm_\\mathrm{object} = \\hbar \\kq",
       "src": "(11.157)"
      },
      {
       "tex": "\\Delta\\keps_\\mathrm{object} = \\hbar\\komegaq",
       "src": "(11.158)"
      }
     ],
     "then": {
      "tex": "\\mk{e}{\\Delta\\keps_\\mathrm{object}} \\leq \\mk{p}{\\Delta \\kpcm}\\mk{v}{\\kvmag}",
      "src": "11.5.1",
      "uses": []
     },
     "steps": [
      {
       "tex": "\\mk{e}{\\hbar\\komegaq} \\leq \\mk{p}{\\hbar \\kq}\\mk{v}{\\kvmag}",
       "uses": [
        0,
        1
       ]
      },
      {
       "tex": "\\mk{v}{\\kvmag} \\geq \\frac{\\mk{e}{\\komegaq}}{\\mk{p}{\\kq}}",
       "uses": []
      }
     ]
    },
    {
     "assumes": [
      {
       "step": 0
      },
      {
       "tex": "\\hbar\\komegaq = \\sqrt{\\kepsq^2 + 2\\knzero\\kUzero\\kepsq}",
       "src": "(11.151)"
      },
      {
       "tex": "\\kepsq = \\hbar^2\\kq^2/2\\km",
       "src": "11.5.1"
      },
      {
       "tex": "\\kssound = \\sqrt{\\frac{\\knzero\\kUzero}{\\km}}",
       "src": "(11.153)"
      }
     ],
     "then": {
      "tex": "\\mk{c}{\\kvc} = \\mk{m}{\\min_{\\kq}\\frac{\\komegaq}{\\kq}}",
      "uses": [
       0
      ],
      "why": "一旦$v$对某个$q$超过$\\omega_q/q$，物体就能产生激发。"
     },
     "steps": [
      {
       "tex": "\\mk{c}{\\kvc} = \\mk{m}{\\min_{\\kq}\\frac{\\sqrt{\\kepsq^2 + 2\\knzero\\kUzero\\kepsq}}{\\hbar\\kq}}",
       "uses": [
        1
       ]
      },
      {
       "tex": "\\mk{c}{\\kvc} = \\mk{m}{\\min_{\\kq}\\sqrt{\\frac{\\hbar^2\\kq^2}{4\\km^2} + \\frac{\\knzero\\kUzero}{\\km}}}",
       "uses": [
        2
       ]
      },
      {
       "tex": "\\mk{c}{\\kvc} = \\mk{m}{\\sqrt{\\frac{\\knzero\\kUzero}{\\km}}}",
       "uses": [],
       "cap": "根号随$q$增大，所以其最小值在$q \\to 0$时取到。"
      },
      {
       "tex": "\\mk{c}{\\kvc} = \\mk{m}{\\kssound}",
       "uses": [
        3
       ]
      }
     ],
     "num": "(11.159)",
     "note": "书中在 (11.158) 中印成$\\Delta\\keps_\\mathrm{object} = \\komegaq$，在 (11.159) 中印成$\\kvmag > \\kvc = \\kepsq/\\hbar\\kq$，即自由粒子能量除以动量。给予激发的能量是$\\hbar\\komegaq$，所以条件是对某个$\\kq$有$\\kvmag \\geq \\komegaq/\\kq$，临界速度是最小的$\\komegaq/\\kq$，即声速$\\kssound$。"
    }
   ]
  },
  {
   "id": "attractive-stability",
